# Gainsight CS (NXT) — Access Key auth
# Generate under Administration > Connectors 2.0 > Gainsight API (Access_Key).
# Docs: https://support.gainsight.com/gainsight_nxt/API_and_Developer_Docs/Generate_REST_API/Generate_REST_API_Key
GAINSIGHT_ACCESS_KEY=
# Tenant domain, e.g. https://acme.gainsightcloud.com (no trailing slash)
GAINSIGHT_BASE_URL=
