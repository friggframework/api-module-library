  "events": {
    "contact.changed": {
      "delivery": "webhook",
      "object": "contact",
      "description": "Xero webhooks are configured in the Developer Portal (not via Accounting API). Payload events carry resourceId + eventCategory CONTACT. Verify with x-xero-signature (HMAC-SHA256 of raw body, base64).",
      "payload": {
        "events": [
          {
            "resourceUrl": "https://api.xero.com/api.xro/2.0/Contacts/...",
            "resourceId": "12345678-abcd-efgh-ijkl-1234567890ab",
            "eventDateUtc": "2026-10-20T12:00:00.000Z",
            "eventType": "UPDATE",
            "eventCategory": "CONTACT",
            "tenantId": "12345678-abcd-efgh-ijkl-1234567890ab",
            "tenantType": "ORGANISATION"
          }
        ],
        "lastEventSequence": 1,
        "entropy": "S0m3r4Nd0mt3xt"
      }
    },
    "invoice.changed": {
      "delivery": "webhook",
      "object": "invoice",
      "description": "Xero Developer Portal webhook for INVOICE category. Same signature scheme as contact.changed.",
      "payload": {
        "events": [
          {
            "resourceUrl": "https://api.xero.com/api.xro/2.0/Invoices/...",
            "resourceId": "12345678-abcd-efgh-ijkl-1234567890ab",
            "eventDateUtc": "2026-10-20T12:00:00.000Z",
            "eventType": "CREATE",
            "eventCategory": "INVOICE",
            "tenantId": "12345678-abcd-efgh-ijkl-1234567890ab",
            "tenantType": "ORGANISATION"
          }
        ],
        "lastEventSequence": 1,
        "entropy": "S0m3r4Nd0mt3xt"
      }
    }
  },
  "capabilities": {
    "connection.list": {
      "kind": "read",
      "method": "getConnections",
      "input": {
        "authEventId": { "type": "string" }
      },
      "output": "connection[]"
    },
    "connection.delete": {
      "kind": "write",
      "method": "deleteConnection",
      "input": {
        "connectionId": { "type": "string", "required": true }
      },
      "output": "void"
    },
