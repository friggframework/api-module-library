# Outreach OAuth application (Developer Portal → your app)
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=

# Space-separated scopes, e.g.:
# accounts.read prospects.all tasks.all users.read webhooks.all
# Scopes are NOT additive — write does not imply read.
OUTREACH_SCOPE=

# Shared Frigg redirect base; module appends /outreach
REDIRECT_URI=https://localhost:3000/redirect

# Optional: signing secret for inbound webhook verification in local/dev
# (production installs should use the per-webhook attributes.secret)
OUTREACH_WEBHOOK_SECRET=
