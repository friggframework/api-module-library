# HiBob service user credentials (HTTP Basic Auth).
# Create under Bob → Service Users, then assign a permission group.
# Sent as Authorization: Basic Base64(service_user_id:service_user_token)
# Docs: https://apidocs.hibob.com/docs/api-service-users
HIBOB_SERVICE_USER_ID=your_service_user_id
HIBOB_SERVICE_USER_TOKEN=your_service_user_token

# Optional. Company id from webhook payloads (`companyId`). When omitted the
# module derives it from People search responses (employees include companyId).
# Needed for empty companies / webhook tenant routing before any employees exist.
HIBOB_COMPANY_ID=

# Optional. Override production base URL (e.g. sandbox).
# Defaults to https://api.hibob.com/v1
# Sandbox: https://api.sandbox.hibob.com/v1
HIBOB_BASE_URL=

# Webhook signing secret from Bob UI (Webhook configuration).
# Used by extensions/webhooks to verify the Bob-Signature header (HMAC-SHA512).
# Comma-separate multiple secrets during rotation.
HIBOB_WEBHOOK_SIGNING_SECRET=
