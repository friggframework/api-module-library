# Adobe Marketo Engage — Custom Service (LaunchPoint) credentials
# https://experienceleague.adobe.com/en/docs/marketo-developer/marketo/rest/authentication
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=

# Optional: full REST base URL override (defaults to https://{munchkinId}.mktorest.com/rest)
# MARKETO_BASE_URL=https://123-ABC-456.mktorest.com/rest

# Munchkin ID is collected via the auth form (or passed to Api as munchkin_id).
# MARKETO_MUNCHKIN_ID=123-ABC-456
