{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist"
  },
  "include": [
    "api.ts",
    "definition.ts",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "jest-setup.js",
    "jest-teardown.js",
    "jest.config.js"
  ]
}