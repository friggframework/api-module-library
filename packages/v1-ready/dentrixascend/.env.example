# Dentrix Ascend / Henry Schein One Public API (OAuth 2.0 client credentials)
# Docs: https://papidocs.hs1api.com/publicapi/api-consumer-guide

DENTRIX_ASCEND_CLIENT_ID=
DENTRIX_ASCEND_CLIENT_SECRET=

# Required Organization-ID header context for Public API calls.
# Discover linked org ids via GET {host}/orgmapper/LinkedOrgs after obtaining a token.
DENTRIX_ASCEND_ORGANIZATION_ID=

# Optional overrides (defaults = production)
# Sandbox API:  https://test.hs1api.com/ascend-gateway/api
# Sandbox host: https://test.hs1api.com
# DENTRIX_ASCEND_BASE_URL=https://prod.hs1api.com/ascend-gateway/api
# DENTRIX_ASCEND_API_HOST=https://prod.hs1api.com

# Official client-credentials flow does not use OAuth scopes or a redirect URI.
# DENTRIX_ASCEND_SCOPE is unused; retained only if a future grant type requires it.
# DENTRIX_ASCEND_SCOPE=
