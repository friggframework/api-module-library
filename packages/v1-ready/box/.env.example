# Box OAuth 2.0 (Developer Console → Configuration)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Space-separated scopes configured on the app (defaults in api.js):
#   root_readwrite manage_webhook
BOX_SCOPE=root_readwrite manage_webhook

# Shared Frigg redirect base; module appends /box
REDIRECT_URI=https://localhost:3000/redirect

# Webhook signature keys (Developer Console → Webhooks → Manage signature keys)
BOX_WEBHOOK_PRIMARY_KEY=
BOX_WEBHOOK_SECONDARY_KEY=
