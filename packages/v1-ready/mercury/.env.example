# Mercury API token from Settings → Tokens (include the secret-token: prefix).
# Sent as Authorization: Bearer <token>. Official docs also allow Basic auth
# with the token as username and an empty password.
MERCURY_API_KEY=

# Optional: webhook signing secret returned once by POST /webhooks (createWebhook).
# Used by extensions/webhooks to verify the Mercury-Signature header.
MERCURY_WEBHOOK_SECRET=
