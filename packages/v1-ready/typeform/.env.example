# Typeform OAuth application (Developer Apps in the Typeform admin panel)
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
# Space-delimited scopes. Always include `offline` for a refresh token.
# Docs: https://www.typeform.com/developers/get-started/scopes/
TYPEFORM_SCOPE=offline accounts:read forms:read forms:write responses:read webhooks:read webhooks:write
# Shared Frigg redirect base; module appends /typeform
REDIRECT_URI=https://localhost:3000/redirect
# Optional: EU data center host (default https://api.typeform.com)
# TYPEFORM_BASE_URL=https://api.eu.typeform.com
# Webhook signature secret (per-webhook `secret` from createOrUpdateWebhook)
TYPEFORM_WEBHOOK_SECRET=
