# PostHog personal API key (Settings → Personal API Keys).
# Sent as: Authorization: Bearer <key>
POSTHOG_API_KEY=phx_your_personal_api_key_here

# Project ID (Settings → Project). Required for project-scoped endpoints.
POSTHOG_PROJECT_ID=12345

# Optional. Defaults to https://us.posthog.com.
# EU Cloud: https://eu.posthog.com
# Must be https, a posthog.com host, with no userinfo or port.
POSTHOG_HOST=https://us.posthog.com
