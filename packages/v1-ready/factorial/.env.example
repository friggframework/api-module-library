# Factorial OAuth application (Settings → Advanced configuration → OAuth applications)
FACTORIAL_CLIENT_ID=
FACTORIAL_CLIENT_SECRET=
# Space-separated scopes. `read` is required for all operations; `write` for mutations.
# Resource scopes used by this module: employees company_legal_entities company_locations
FACTORIAL_SCOPE=read write employees company_legal_entities company_locations
# Shared Frigg redirect base; module appends /factorial
REDIRECT_URI=https://localhost:3000/redirect
# Optional: pin demo vs production API host (default production)
# FACTORIAL_BASE_URL=https://api.factorialhr.com/api/2026-10-01
# FACTORIAL_AUTH_BASE_URL=https://id.factorialhr.com
# Webhook challenge echo (must match subscription.challenge)
FACTORIAL_WEBHOOK_CHALLENGE=
