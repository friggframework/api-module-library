# OAuth 2.0 (Marketplace app — Location-scoped tokens)
GOHIGHLEVEL_CLIENT_ID=
GOHIGHLEVEL_CLIENT_SECRET=
# Space-separated scopes. Core CRM defaults used when unset:
# contacts.readonly contacts.write businesses.readonly businesses.write
# opportunities.readonly opportunities.write locations.readonly users.readonly
GOHIGHLEVEL_SCOPE=contacts.readonly contacts.write businesses.readonly businesses.write opportunities.readonly opportunities.write locations.readonly users.readonly
REDIRECT_URI=https://localhost:3000/redirect

# Optional override for the Version request header (default 2021-07-28).
# Marketplace docs currently also document "v3".
GOHIGHLEVEL_API_VERSION=2021-07-28

# Ed25519 public key PEM for verifying X-GHL-Signature on inbound webhooks
# (from https://marketplace.gohighlevel.com/docs/webhook/WebhookIntegrationGuide).
# May be stored single-line with literal \n escapes.
GOHIGHLEVEL_WEBHOOK_PUBLIC_KEY_ED25519=
