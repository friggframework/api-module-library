# Authentication token from the ProcurementExpress account (sent as authentication_token header)
PROCUREMENT_EXPRESS_AUTHENTICATION_TOKEN=
# Active company / employer id (sent as app_company_id header)
PROCUREMENT_EXPRESS_COMPANY_ID=
# Optional override; default is https://app.procurementexpress.com/api/v1
PROCUREMENT_EXPRESS_BASE_URL=

# Optional: Basic Auth credentials configured on the PE webhook subscription
PROCUREMENT_EXPRESS_WEBHOOK_BASIC_USER=
PROCUREMENT_EXPRESS_WEBHOOK_BASIC_PASSWORD=
