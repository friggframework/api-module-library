  "events": {
    "trello.action": {
      "delivery": "webhook",
      "object": "card",
      "description": "Any Action on a watched model (board/list/card/member/organization). Payload carries action, model, webhook.",
      "payload": {
        "action": {
          "id": "51f9424bcd6e040f3c002412",
          "type": "updateCard",
          "date": "2013-07-31T16:58:51.949Z",
          "idMemberCreator": "4fc78a59a885233f4b349bd9",
          "data": {}
        },
        "model": {
          "id": "4d5ea62fd76aa1136000000c",
          "name": "Example Board"
        },
        "webhook": {
          "id": "5f5ea62fd76aa1136003300c",
          "idModel": "4d5ea62fd76aa1136000000c",
          "callbackURL": "https://example.com/webhooks/trello?memberId=4fc78a59a885233f4b349bd9",
          "active": true
        }
      },
      "record": "model"
    }
  },
  "webhook": {
    "scope": "token",
    "topic": "{{body.action.type}}",
    "eventId": "{{body.action.id}}",
    "account": "{{body.webhook.callbackURL}}",
    "verify": "verifyWebhookSignature"
  },
