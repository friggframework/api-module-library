{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "mailchimp",
  "label": "Mailchimp",
  "package": "@friggframework/api-module-mailchimp",
  "version": "1.0.0",
  "auth": "oauth2",
  "objects": {
    "account": {
      "label": "Account",
      "fields": [
        {
          "name": "account_id",
          "type": "id",
          "tag": "record.externalId",
          "readOnly": true
        },
        {
          "name": "account_name",
          "type": "string",
          "tag": "organization.name"
        },
        {
          "name": "email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "username",
          "type": "string"
        },
        {
          "name": "role",
          "type": "string",
          "readOnly": true
        }
      ]
    },
    "list": {
      "label": "Audience / List",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "name",
          "type": "string",
          "tag": "list.name"
        },
        {
          "name": "date_created",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "stats.member_count",
          "type": "number",
          "readOnly": true
        },
        {
          "name": "permission_reminder",
          "type": "string"
        },
        {
          "name": "contact.company",
          "type": "string",
          "tag": "organization.name"
        }
      ],
      "sync": {
        "id": "id",
        "list": {
          "capability": "list.list",
          "items": "lists",
          "limit": "count",
          "offset": "offset"
        },
        "get": {
          "capability": "list.get",
          "id": "listId"
        },
        "create": {
          "capability": "list.create",
          "body": "body"
        },
        "update": {
          "capability": "list.update",
          "id": "listId",
          "body": "body"
        }
      }
    },
    "member": {
      "label": "List Member",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "email_address",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "status",
          "type": "enum",
          "tag": "contact.emailConsent",
          "values": [
            "subscribed",
            "unsubscribed",
            "cleaned",
            "pending",
            "transactional",
            "archived"
          ]
        },
        {
          "name": "merge_fields.FNAME",
          "type": "string",
          "tag": "person.givenName"
        },
        {
          "name": "merge_fields.LNAME",
          "type": "string",
          "tag": "person.familyName"
        },
        {
          "name": "merge_fields.PHONE",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "merge_fields.ADDRESS",
          "type": "json",
          "tag": "address.full"
        },
        {
          "name": "last_changed",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        },
        {
          "name": "timestamp_signup",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "vip",
          "type": "boolean"
        },
        {
          "name": "tags",
          "type": "json",
          "tag": "record.tags"
        },
        {
          "name": "list_id",
          "type": "string",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "id",
        "updatedAt": "last_changed",
        "list": {
          "capability": "member.list",
          "items": "members",
          "limit": "count",
          "offset": "offset",
          "since": "since_last_changed"
        },
        "get": {
          "capability": "member.get",
          "id": "subscriberHashOrEmail"
        },
        "create": {
          "capability": "member.create",
          "body": "body"
        },
        "update": {
          "capability": "member.update",
          "id": "subscriberHashOrEmail",
          "body": "body"
        }
      }
    },
    "campaign": {
      "label": "Campaign",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "type",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string",
          "readOnly": true
        },
        {
          "name": "settings.subject_line",
          "type": "string"
        },
        {
          "name": "settings.title",
          "type": "string"
        },
        {
          "name": "settings.from_name",
          "type": "string"
        },
        {
          "name": "settings.reply_to",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "send_time",
          "type": "datetime",
          "readOnly": true
        },
        {
          "name": "recipients.list_id",
          "type": "string"
        }
      ]
    }
  },
  "events": {
    "member.subscribed": {
      "delivery": "webhook",
      "object": "member",
      "subscribe": "webhook.create",
      "description": "List webhook type=subscribe when a subscriber is added.",
      "payload": {
        "type": "subscribe",
        "fired_at": "2009-03-26 21:35:57",
        "data": {
          "id": "8a25ff1d98",
          "list_id": "a6b5da1054",
          "email": "api@mailchimp.com",
          "email_type": "html",
          "merges": {
            "EMAIL": "api@mailchimp.com",
            "FNAME": "Mailchimp",
            "LNAME": "API"
          }
        }
      },
      "record": "data",
      "match": "subscribe"
    },
    "member.unsubscribed": {
      "delivery": "webhook",
      "object": "member",
      "subscribe": "webhook.create",
      "description": "List webhook type=unsubscribe.",
      "payload": {
        "type": "unsubscribe",
        "fired_at": "2009-03-26 21:40:57",
        "data": {
          "action": "unsub",
          "reason": "manual",
          "id": "8a25ff1d98",
          "list_id": "a6b5da1054",
          "email": "api+unsub@mailchimp.com"
        }
      },
      "record": "data",
      "match": "unsubscribe"
    },
    "member.profile_updated": {
      "delivery": "webhook",
      "object": "member",
      "subscribe": "webhook.create",
      "description": "List webhook type=profile when a contact's profile is updated.",
      "match": "profile"
    },
    "member.cleaned": {
      "delivery": "webhook",
      "object": "member",
      "subscribe": "webhook.create",
      "description": "List webhook type=cleaned when an address is cleaned.",
      "match": "cleaned"
    },
    "member.email_changed": {
      "delivery": "webhook",
      "object": "member",
      "subscribe": "webhook.create",
      "description": "List webhook type=upemail when a subscriber's email changes.",
      "match": "upemail"
    },
    "campaign.sent_or_cancelled": {
      "delivery": "webhook",
      "object": "campaign",
      "subscribe": "webhook.create",
      "description": "List webhook type=campaign when a campaign is sent or cancelled.",
      "match": "campaign"
    }
  },
  "webhook": {
    "scope": "list",
    "topic": "{{body.type}}",
    "eventId": "{{body.data.id}}-{{body.fired_at}}",
    "verify": "extensions/webhooks/signature-verifier.verifyMailchimpSignature"
  },
  "capabilities": {
    "account.getRoot": {
      "kind": "read",
      "method": "getRoot",
      "input": {},
      "output": "account"
    },
    "account.getPing": {
      "kind": "read",
      "method": "getPing",
      "input": {},
      "output": "void"
    },
    "list.list": {
      "kind": "read",
      "method": "getLists",
      "input": {
        "count": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "email": {
          "type": "string"
        }
      },
      "output": "page<list>"
    },
    "list.get": {
      "kind": "read",
      "method": "getListsId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        }
      },
      "output": "list"
    },
    "list.create": {
      "kind": "write",
      "method": "postLists",
      "input": {
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "list"
    },
    "list.update": {
      "kind": "write",
      "method": "patchListsId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "list"
    },
    "member.list": {
      "kind": "read",
      "method": "getListsIdMembers",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "count": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "since_last_changed": {
          "type": "string"
        }
      },
      "output": "page<member>"
    },
    "member.get": {
      "kind": "read",
      "method": "getListsIdMembersId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "subscriberHashOrEmail": {
          "type": "string",
          "required": true
        }
      },
      "output": "member"
    },
    "member.create": {
      "kind": "write",
      "method": "postListsIdMembers",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "member"
    },
    "member.update": {
      "kind": "write",
      "method": "patchListsIdMembersId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "subscriberHashOrEmail": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "member"
    },
    "member.upsert": {
      "kind": "write",
      "method": "putListsIdMembersId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "subscriberHashOrEmail": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "member"
    },
    "campaign.list": {
      "kind": "read",
      "method": "getCampaigns",
      "input": {
        "count": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "list_id": {
          "type": "string"
        }
      },
      "output": "page<campaign>"
    },
    "campaign.get": {
      "kind": "read",
      "method": "getCampaignsId",
      "input": {
        "campaignId": {
          "type": "string",
          "required": true
        }
      },
      "output": "campaign"
    },
    "campaign.create": {
      "kind": "write",
      "method": "postCampaigns",
      "input": {
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "campaign"
    },
    "campaign.update": {
      "kind": "write",
      "method": "patchCampaignsId",
      "input": {
        "campaignId": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "campaign"
    },
    "webhook.list": {
      "kind": "read",
      "method": "getListsIdWebhooks",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        }
      },
      "output": "webhook[]"
    },
    "webhook.get": {
      "kind": "read",
      "method": "getListsIdWebhooksId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "webhookId": {
          "type": "string",
          "required": true
        }
      },
      "output": "webhook"
    },
    "webhook.create": {
      "kind": "subscribe",
      "method": "postListsIdWebhooks",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "url": {
          "type": "string",
          "required": true
        },
        "events": {
          "type": "object"
        },
        "sources": {
          "type": "object"
        }
      },
      "output": "webhook",
      "notes": "Append ?account_id={account_id} to url so extensions/webhooks can reverse-look up the owning integration (classic payloads carry list_id only)."
    },
    "webhook.update": {
      "kind": "write",
      "method": "patchListsIdWebhooksId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "webhookId": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "object",
          "required": true
        }
      },
      "output": "webhook"
    },
    "webhook.delete": {
      "kind": "delete",
      "method": "deleteListsIdWebhooksId",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "webhookId": {
          "type": "string",
          "required": true
        }
      },
      "output": "void"
    }
  },
  "options": {
    "list": {
      "capability": "list.list",
      "label": "{{item.name}}",
      "value": "$.item.id"
    }
  },
  "openQuestions": {
    "webhookAccountLookup": "Classic list webhook payloads include data.list_id but not account_id. Extension resolve expects ?account_id= on the callback URL (recommended at postListsIdWebhooks time) matching GET / account_id. Not addressed by the Marketing swagger.",
    "signedWebhookBodyEncoding": "Official sync guide documents application/x-www-form-urlencoded bodies; signature examples also json_decode the raw body. Not specified in marketing.json.",
    "lefthookManifest": "lefthookhq/lefthook-bots was not publicly accessible from this environment; no draft manifest was available to start from.",
    "vendorSpec": "Aligned to official codegen Swagger 2.0 v3.0.91 (https://raw.githubusercontent.com/mailchimp/mailchimp-client-lib-codegen/main/spec/marketing.json): host server.api.mailchimp.com + /3.0, securityDefinitions.basicAuth only (no OAuth scopes on Marketing API), vendor operationIds.",
    "webhookSigningFields": "marketing.json v3.0.91 list-webhook schemas do not include signing_secret / signing_enabled; those appear in the developer webhook guide. Extension signature verification follows the guide; confirm against live create responses whether secrets are returned outside this swagger revision."
  }
}
