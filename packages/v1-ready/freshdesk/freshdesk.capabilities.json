        { "name": "company_id", "tags": ["identifier"] },
        { "name": "group_id", "tags": ["identifier"] },
        { "name": "tags", "tags": [] },
        { "name": "created_at", "tags": ["timestamp"] },
        { "name": "updated_at", "tags": ["timestamp"] }
