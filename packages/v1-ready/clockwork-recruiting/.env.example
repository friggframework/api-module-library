# Clockwork Recruiting OAuth app (central account host).
# Register the redirect URI in the Clockwork OAuth app settings.
CLOCKWORK_OAUTH_CLIENT_ID=your_client_id
CLOCKWORK_OAUTH_CLIENT_SECRET=your_client_secret

# Dedicated redirect URI for this module (preferred).
# Falls back to ${REDIRECT_URI}/clockwork-recruiting when unset.
CLOCKWORK_RECRUITING_REDIRECT_URI=https://your-app.example.com/redirect/clockwork-recruiting

# OAuth + resource host stage: local | qa | prod (default prod).
CLOCKWORK_STAGE=prod

# Optional: shared Frigg redirect base used when CLOCKWORK_RECRUITING_REDIRECT_URI is unset.
# REDIRECT_URI=https://your-app.example.com/redirect
