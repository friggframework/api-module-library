# Shop-Ware Partner API credentials (requested from Shop-Ware support).
# Sent on every request as X-Api-Partner-Id and X-Api-Secret.
# Docs: https://shop-ware.stoplight.io/docs/public-api/6b3x0hrgt5ek5-authentication
SHOPWARE_API_PARTNER_ID=your_partner_id_here
SHOPWARE_API_SECRET=your_api_secret_here

# Optional default tenant for tenant-scoped calls. Can also be passed per method.
SHOPWARE_TENANT_ID=
