# Chargebee site subdomain (the {site} in https://{site}.chargebee.com).
# Test sites are typically named like acme-test.
CHARGEBEE_SITE=your-site-subdomain

# Full-access or read-only API key from
# Settings > Configure Chargebee > API Keys and Webhooks.
# Sent as HTTP Basic username with an empty password.
CHARGEBEE_API_KEY=your_chargebee_api_key_here

# Optional: Basic Auth credentials Chargebee uses when delivering webhooks
# to this module's /webhooks route (configured on the webhook endpoint).
CHARGEBEE_WEBHOOK_USERNAME=
CHARGEBEE_WEBHOOK_PASSWORD=
