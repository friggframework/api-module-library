# TriNet HR Platform OAuth 2.0 (register an application with TriNet Developer Program)
TRINET_CLIENT_ID=
TRINET_CLIENT_SECRET=
# Space-delimited scopes. `platform` is mandatory. Example:
# platform companies people employments departments locations time_off.vacation_requests
TRINET_SCOPE=platform companies people employments departments locations
# OAuth redirect (must be whitelisted with TriNet during Beta)
REDIRECT_URI=
# Shared secret for inbound webhook Signature header verification (not the OAuth client secret)
TRINET_WEBHOOK_SHARED_SECRET=
