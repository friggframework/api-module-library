# ServiceTitan uses the OAuth2 client_credentials grant, so there is no
# redirect and no REDIRECT_URI. All four values come from the tenant.
#
# tenant_id:     Settings > Integrations > API Application Access
# app_key:       generated with your app in the Developer Portal
# client_id:     shown after an admin connects your app under API Application Access
# client_secret: shown ONCE at that point; regenerate if lost
#
# Production and integration credentials are NOT interchangeable.
SERVICETITAN_ENVIRONMENT=production
SERVICETITAN_TENANT_ID=
SERVICETITAN_APP_KEY=
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=

# Per-app secret from the Developer Portal, used to verify V2 webhook deliveries.
SERVICETITAN_WEBHOOK_SECRET=
