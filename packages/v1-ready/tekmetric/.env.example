# OAuth 2.0 client credentials issued by Tekmetric after partner approval.
# Request access at https://api.tekmetric.com/
TEKMETRIC_CLIENT_ID=
TEKMETRIC_CLIENT_SECRET=

# Optional: environment selector. Default is production.
# Set to `sandbox` to use https://sandbox.tekmetric.com/api/v1
# TEKMETRIC_ENVIRONMENT=sandbox

# Optional: full API base override (wins over TEKMETRIC_ENVIRONMENT).
# Production: https://shop.tekmetric.com/api/v1
# Sandbox:    https://sandbox.tekmetric.com/api/v1
# TEKMETRIC_BASE_URL=

# Optional: pre-issued bearer access token (skips the token exchange when set).
# The source Left Hook client called this TEKMETRIC_API_KEY; it is the OAuth
# access_token, not a separate API-key product.
TEKMETRIC_API_KEY=

# Client-credentials grant has no browser redirect. TEKMETRIC_REDIRECT_URI is
# intentionally unused; keep unset.
