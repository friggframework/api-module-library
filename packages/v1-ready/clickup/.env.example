# OAuth app from ClickUp Settings → Apps → Create new app
# https://developer.clickup.com/docs/authentication
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# Optional: ClickUp OAuth does not document scopes; leave empty unless required
CLICKUP_SCOPE=
# Shared redirect base used by Frigg apps (module appends /clickup)
REDIRECT_URI=https://localhost:3000/redirect

# Optional: single webhook HMAC secret for local/dev receive-path verification.
# Production ClickUp secrets are per-webhook (returned by createWebhook).
CLICKUP_WEBHOOK_SECRET=
