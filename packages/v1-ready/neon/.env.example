# Neon CRM (API v2) — HTTP Basic: Org ID + API key
# https://developer.neoncrm.com/authentication/
NEON_ORG_ID=
NEON_API_KEY=

# production (default) → https://api.neoncrm.com/v2
# trial               → https://trial.neoncrm.com/v2
NEON_ENVIRONMENT=production

# Optional absolute override of the environment-derived base URL
# NEON_BASE_URL=https://api.neoncrm.com/v2

# Optional inbound webhook Basic auth (when the Neon subscription requires it)
# NEON_WEBHOOK_USERNAME=
# NEON_WEBHOOK_PASSWORD=
