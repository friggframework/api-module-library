# Totango personal access token (Profile → Edit Profile → Integration → Create Token).
# Sent on every request as the `app-token` header.
# Docs: https://support.totango.com/hc/en-us/articles/203036939-Personal-Access-Token-and-Service-ID
TOTANGO_APP_TOKEN=your_totango_app_token_here

# Optional region override. Default US: https://api.totango.com
# EU: https://api-eu1.totango.com
# TOTANGO_BASE_URL=https://api.totango.com

# Optional Customer Data Hub host (official OpenAPI servers).
# US: https://int-hub.totango.com/api/v1
# EU: https://int-hub-eu1.totango.com/api/v1
# TOTANGO_CDH_BASE_URL=https://int-hub.totango.com/api/v1
