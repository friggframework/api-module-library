  "auth": {
    "type": "http_basic",
    "scheme": "basic",
    "usernameField": "api_key",
    "password": "",
    "notes": "Chargebee HTTP Basic: API key as username, empty password. Scoped to site subdomain in the base URL https://{site}.chargebee.com/api/v2.",
    "identityMethod": "site subdomain from auth form",
    "entityKey": "site",
    "credentialFields": ["api_key", "site"],
    "docs": "https://apidocs.chargebee.com/docs/api/auth?prod_cat_ver=2"
  },
