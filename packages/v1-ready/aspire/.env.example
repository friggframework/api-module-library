# Aspire Cloud API — client credentials (Administration > Application > API).
# Docs: https://guide.youraspire.com/apidocs/authentication-authorization-2.md
ASPIRE_CLIENT_ID=your_aspire_client_id
ASPIRE_CLIENT_SECRET=your_aspire_client_secret

# Optional override (default: https://cloud-api.youraspire.com).
# Sandbox: https://cloudsandbox-api.youraspire.com
ASPIRE_API_BASE_URL=https://cloud-api.youraspire.com
