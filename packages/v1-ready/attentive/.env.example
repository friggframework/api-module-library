# OAuth public app (authorization-code grant). Create an app in the Attentive
# platform and copy client id/secret from Manage Distribution.
ATTENTIVE_CLIENT_ID=
ATTENTIVE_CLIENT_SECRET=
# Space-delimited scopes. See https://docs.attentive.com/docs/authentication
ATTENTIVE_SCOPE=subscriptions:write subscriptions:read events:write ecommerce:write attributes:write product_catalogs:write product_catalogs:read webhooks:write
# Frigg shared redirect base; definition appends /attentive
REDIRECT_URI=https://localhost:3000/redirect

# Optional override of the REST base (default https://api.attentivemobile.com/v1)
# ATTENTIVE_BASE_URL=

# Webhook HMAC signing key from the Attentive app Webhooks tab
# (x-attentive-hmac-sha256). Not returned by the Webhooks API create response.
ATTENTIVE_WEBHOOK_SIGNING_KEY=
