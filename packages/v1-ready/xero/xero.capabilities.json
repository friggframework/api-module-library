{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "xero",
  "label": "Xero",
  "package": "@friggframework/api-module-xero",
  "version": "1.0.0",
  "auth": "oauth2",
  "account": {
    "description": "Values about the connected Xero organisation, persisted by the module (apiPropertiesToPersist). Definitions read them as $.install.accounts.xero.<name>.",
    "fields": [
      {
        "name": "tenantId",
        "type": "string",
        "description": "Xero organisation tenant id sent as the xero-tenant-id header on Accounting API calls"
      }
    ]
  },
  "objects": {
    "organisation": {
      "label": "Organisation",
      "fields": [
        {
          "name": "OrganisationID",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "Name",
          "type": "string",
          "tag": "organization.name",
          "required": true
        },
        {
          "name": "LegalName",
          "type": "string",
          "tag": "organization.legalName"
        },
        {
          "name": "BaseCurrency",
          "type": "string",
          "tag": "organization.currency"
        },
        {
          "name": "CountryCode",
          "type": "string",
          "tag": "address.country"
        },
        {
          "name": "OrganisationType",
          "type": "string"
        },
        {
          "name": "ShortCode",
          "type": "string",
          "readOnly": true
        },
        {
          "name": "IsDemoCompany",
          "type": "boolean",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "OrganisationID",
        "get": {
          "capability": "organisation.get"
        }
      }
    },
    "contact": {
      "label": "Contact",
