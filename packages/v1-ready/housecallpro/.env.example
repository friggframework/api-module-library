# Housecall Pro OAuth 2.0 app credentials.
# Register an app with Housecall Pro and obtain client_id / client_secret.
# Authorize URL uses scope=public per https://docs.housecallpro.com/
# OAuth callback URL must match REDIRECT_URI/housecallpro.
HOUSECALLPRO_CLIENT_ID=your_housecallpro_client_id
HOUSECALLPRO_CLIENT_SECRET=your_housecallpro_client_secret

# Shared Frigg redirect base; the module appends /housecallpro.
REDIRECT_URI=https://your-app.example.com/redirect

# Optional: default OAuth scope (docs examples use "public").
# HOUSECALLPRO_SCOPE=public

# Optional: webhook signing secret from the Housecall Pro Webhooks app
# (My Apps > Webhooks). Used by extensions/webhooks signature verification.
# HOUSECALLPRO_WEBHOOK_SECRET=your_signing_secret

# Optional: multi-location X-Company-Id header default for API calls.
# HOUSECALLPRO_COMPANY_ID=location-uuid
