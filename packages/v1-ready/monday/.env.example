# monday.com OAuth app credentials (Developer Center → OAuth).
# https://developer.monday.com/apps/docs/oauth
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

# Dedicated OAuth redirect URI registered on the monday app (full URL).
# Do not derive from REDIRECT_URI — use this env var only.
MONDAY_REDIRECT_URI=https://your-app.example.com/redirect/monday

# Space-separated OAuth scopes configured on the app. Defaults in api.js cover
# identity, boards, and webhooks when this is unset.
# Example: me:read account:read boards:read boards:write webhooks:read webhooks:write
MONDAY_SCOPE=

# Optional: pin GraphQL API version (API-Version header). Default: 2026-07.
# https://developer.monday.com/api-reference/docs/api-versioning
MONDAY_API_VERSION=2026-07

# App Signing Secret from the Developer Center — used to verify HS256 JWTs on
# integration / app webhook deliveries (Authorization header). alg:none rejected.
# https://developer.monday.com/apps/docs/authorization-header
MONDAY_SIGNING_SECRET=
