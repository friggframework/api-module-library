# Atlassian OAuth 2.0 (3LO) app credentials from https://developer.atlassian.com/console
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Space-separated classic scopes; offline_access required for refresh tokens
JIRA_SCOPE=read:jira-user read:jira-work write:jira-work manage:jira-webhook offline_access
# Base redirect URI without the /jira suffix (Definition appends /jira)
REDIRECT_URI=https://localhost:3000/redirect
