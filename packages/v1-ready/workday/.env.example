# Workday OAuth (Developer Site API Client / API Client for Integrations)
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
# Refresh token from authorization-code flow or Manage Refresh Tokens for Integrations
WORKDAY_REFRESH_TOKEN=
# Tenant alias (Extend client-credentials / identity). Example: acme
WORKDAY_TENANT_ALIAS=
# Auth mode: "extend" (default, API Gateway) or "integrations" (tenanted /ccx)
WORKDAY_AUTH_MODE=extend
# Required when WORKDAY_AUTH_MODE=integrations — hostname from View API Clients
WORKDAY_TENANT_HOSTNAME=
# Optional overrides (defaults shown)
# WORKDAY_TOKEN_URL=https://auth.api.workday.com/v1/token
# WORKDAY_BASE_URL=https://api.workday.com/common/v1
# WORKDAY_STAFFING_BASE_URL=https://api.workday.com/staffing/v1
# WORKDAY_ABSENCE_BASE_URL=https://api.workday.com/absenceManagement/v5
