# Dropbox App Console → your app → Settings
# https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Space-separated scopes (Permissions tab). Webhooks need files.metadata.read.
# Defaults in api.js (when unset) include OpenID + files + sharing.read:
#   openid profile email account_info.read files.metadata.read files.metadata.write
#   files.content.read files.content.write sharing.read
DROPBOX_SCOPE=openid profile email account_info.read files.metadata.read files.metadata.write files.content.read files.content.write sharing.read

# Shared with other Frigg modules; Dropbox redirect is `${REDIRECT_URI}/dropbox`
REDIRECT_URI=https://localhost:3000/redirect

# App secret is also used to verify X-Dropbox-Signature on webhook POSTs.
# (Same value as DROPBOX_CLIENT_SECRET.)
