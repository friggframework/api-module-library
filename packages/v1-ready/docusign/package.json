  "bugs": {
    "url": "https://github.com/friggframework/frigg/issues"
  },
  "homepage": "https://github.com/friggframework/frigg/tree/main/packages/v1-ready/docusign#readme",
  "dependencies": {
    "@friggframework/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0"
  },
  "publishConfig": {
