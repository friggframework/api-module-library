# Rippling App Shop OAuth (partner listing).
# Create a listing in the Rippling Developer Portal; Client ID/Secret live
# under Listing credentials. Partner approval is required for App Shop apps.
# Docs: https://developer.rippling.com/documentation/developer-portal/v2-guides/installation
RIPPLING_CLIENT_ID=your_rippling_client_id
RIPPLING_CLIENT_SECRET=your_rippling_client_secret
# PLATFORM app name used in authorize URL:
#   https://app.rippling.com/apps/PLATFORM/{APP_NAME}/authorize
RIPPLING_APP_NAME=YourAppName
# Space-separated App Shop scopes (examples):
#   companies.read workers.read users.read departments.read departments.read-write
#   work-locations.read work-locations.read-write draft-hires.read-write
RIPPLING_SCOPE=companies.read workers.read users.read departments.read work-locations.read
# Shared Frigg redirect base; module appends /rippling
REDIRECT_URI=https://localhost:3000/redirect
