# PandaDoc OAuth 2.0 application credentials.
# Create an app in the PandaDoc Developer Dashboard:
# https://app.pandadoc.com/a/#/settings/api-dashboard/configuration
# Scopes: space-separated `read` and/or `write` (recommended: `read write`).
# `read+write` is deprecated per PandaDoc docs.
PANDADOC_CLIENT_ID=your_pandadoc_client_id
PANDADOC_CLIENT_SECRET=your_pandadoc_client_secret
PANDADOC_SCOPE=read write

# Shared base redirect URI used by Frigg. The module appends `/pandadoc`.
REDIRECT_URI=https://localhost:3000/redirect

# Optional: shared key for inbound webhook signature verification
# (HMAC-SHA256 of the raw body; signature arrives as ?signature=).
# Prefer the per-subscription shared_key returned by createWebhookSubscription.
PANDADOC_WEBHOOK_SHARED_KEY=
