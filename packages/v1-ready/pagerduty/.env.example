# PagerDuty App OAuth credentials (PagerDuty → Integrations → App Registration)
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=
# Classic User OAuth scopes are `read` or `write` (case-sensitive).
# Scoped OAuth uses space-separated resource scopes (e.g. incidents.read services.write).
# Default here is Classic User OAuth write (includes read).
PAGERDUTY_SCOPE=write
# Shared Frigg redirect host; the module appends /pagerduty
REDIRECT_URI=https://localhost:3000/redirect
# Optional webhook verification (subscription secret returned once on create)
# PAGERDUTY_WEBHOOK_SECRET=
