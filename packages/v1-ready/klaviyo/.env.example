# --- OAuth 2.0 + PKCE (primary; required for App Marketplace) ---
# Create an app at https://www.klaviyo.com/manage-apps
# Authorize: https://www.klaviyo.com/oauth/authorize
# Token:     https://a.klaviyo.com/oauth/token
# Docs: https://developers.klaviyo.com/en/docs/set_up_oauth
KLAVIYO_CLIENT_ID=your_oauth_client_id
KLAVIYO_CLIENT_SECRET=your_oauth_client_secret
# Space-separated scopes, e.g. accounts:read profiles:read profiles:write lists:read lists:write ...
KLAVIYO_SCOPE=accounts:read profiles:read profiles:write lists:read lists:write events:read events:write subscriptions:write webhooks:read webhooks:write
# REDIRECT_URI is the Frigg app base; definition appends /klaviyo
REDIRECT_URI=https://your-frigg-app.example.com/redirect

# --- Private API key (optional; alongside OAuth) ---
# Used when api_key is set and no access_token is present.
# Authorization: Klaviyo-API-Key pk_…
# Docs: https://developers.klaviyo.com/en/docs/authenticate_
# KLAVIYO_API_KEY=pk_your_private_api_key_here

# Optional override for the required `revision` header (default: 2026-10-15).
# KLAVIYO_REVISION=2026-10-15

# Shared secret_key used when creating system webhooks, for inbound signature
# verification in extensions/webhooks. Min 16 characters.
# Docs: https://developers.klaviyo.com/en/docs/working_with_system_webhooks
# KLAVIYO_WEBHOOK_SECRET=your_webhook_signing_secret
