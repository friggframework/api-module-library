# ModMed Certified FHIR R4 (SMART on FHIR) — OAuth 2.0 authorization code.
# Register at https://portal.api.modmed.com/docs/register-to-become-a-modmed-certified-fhir-api-vendor
# Auth docs: https://portal.api.modmed.com/reference/authentication-2

MODMED_CLIENT_ID=your_modmed_client_id
MODMED_CLIENT_SECRET=your_modmed_client_secret

# Dedicated redirect URI for this module (preferred). Falls back to ${REDIRECT_URI}/modmed.
MODMED_REDIRECT_URI=https://your-app.example/redirect/modmed

# Space-separated SMART scopes. Default includes openid/fhirUser + offline_access
# for refresh tokens, launch/patient, and wildcard resource scopes from the ported
# module. Official Certified docs also document SMARTv2 `.rs` scopes
# (e.g. patient/Patient.rs) — override here if your app registration requires them.
MODMED_SCOPE=openid fhirUser offline_access launch/patient patient/*.read user/*.read user/*.write

# Practice FHIR R4 base URL used as `aud` and as the API base
# (customer endpoint from the ModMed directory, or the demonstration endpoint).
# Example demonstration base from Certified auth docs:
#   https://fhirmp.mmi.prod.fhir.ema-api.com/fhir/r4
MODMED_FHIR_BASE=https://fhirmp.mmi.prod.fhir.ema-api.com/fhir/r4
