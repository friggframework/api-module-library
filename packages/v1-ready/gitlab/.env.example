# GitLab OAuth application (User Settings → Applications, or Group/Instance apps).
# Docs: https://docs.gitlab.com/integration/oauth_provider/
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Space-separated OAuth scopes. Core module methods need `api` (read/write) and
# `read_user` (GET /user identity). Example:
# api read_user
GITLAB_SCOPE=api read_user
# Shared Frigg redirect base; module appends /gitlab
REDIRECT_URI=https://localhost:3000/redirect

# Optional — override for GitLab Self-Managed / Dedicated (default gitlab.com).
# API base becomes ${GITLAB_HOST}/api/v4; OAuth at ${GITLAB_HOST}/oauth/*.
# GITLAB_HOST=https://gitlab.example.com

# Optional — default secret token / signing token used by verifyWebhookSignature
# when creating project hooks with `token` or `signing_token` (whsec_…).
# GITLAB_WEBHOOK_SECRET=
