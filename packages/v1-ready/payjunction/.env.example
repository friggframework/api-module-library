# PayJunction OAuth application credentials (partner / Trinity OAuth app).
# Public developer docs also document HTTP Basic (apiLogin:apiPassword) —
# this module ports the Left Hook OAuth2 authorization-code flow.
PAYJUNCTION_CLIENT_ID=
PAYJUNCTION_CLIENT_SECRET=

# Application key required on every API request (X-PJ-Application-Key).
# Request labs + production keys from PayJunction developer support.
PAYJUNCTION_APP_KEY=

# OAuth scope. Source / partner notes use "read write".
# Not listed on the public developer portal — treat as UNVALIDATED.
PAYJUNCTION_SCOPE=read write

# Dedicated redirect URI for this module (preferred).
# Falls back to ${REDIRECT_URI}/payjunction when unset.
PAYJUNCTION_REDIRECT_URI=https://localhost:3000/redirect/payjunction
REDIRECT_URI=https://localhost:3000/redirect

# Optional: use PayJunction Labs hosts (api.payjunctionlabs.com).
# PAYJUNCTION_SANDBOX=true
# Or override the API base URL directly:
# PAYJUNCTION_BASE_URL=https://api.payjunctionlabs.com
# PAYJUNCTION_AUTH_BASE_URL=https://www.payjunctionlabs.com

# Shared secret used when creating webhook subscriptions (X-Pj-Signature).
# PAYJUNCTION_WEBHOOK_SECRET=
