# Airtable OAuth integration (register at https://airtable.com/create/oauth).
# Token endpoint uses HTTP Basic (client_id:client_secret) + PKCE.
AIRTABLE_CLIENT_ID=your_airtable_client_id
AIRTABLE_CLIENT_SECRET=your_airtable_client_secret
# Space-delimited scopes selected for the OAuth integration.
AIRTABLE_SCOPE=data.records:read data.records:write schema.bases:read webhook:manage user.email:read
# Shared Frigg redirect base; module appends /airtable.
REDIRECT_URI=https://localhost:3000/redirect

# Optional: personal access token for local/dev (Bearer). Prefer OAuth for
# third-party / marketplace connections.
# AIRTABLE_ACCESS_TOKEN=patXXXXXXXX

# Optional single-tenant webhook MAC secret (base64) for local verification.
# Production multi-tenant flows store macSecretBase64 from createWebhook.
# AIRTABLE_WEBHOOK_MAC_SECRET=
