# Public API workspace token (Settings → Access Management → Tokens)
SEGMENT_PUBLIC_API_TOKEN=

# Optional: Unify Profile API (HTTP Basic username, empty password)
SEGMENT_PROFILE_API_TOKEN=
SEGMENT_SPACE_ID=

# Optional: override hosts (defaults are US)
# SEGMENT_PUBLIC_API_BASE_URL=https://api.segmentapis.com
# SEGMENT_PROFILE_API_BASE_URL=https://profiles.segment.com/v1
# EU Public API: https://eu1.api.segmentapis.com
# EU Profile API: https://profiles.euw1.segment.com/v1

# Webhooks (Actions) destination shared secret → X-Signature HMAC-SHA1
SEGMENT_WEBHOOK_SHARED_SECRET=
