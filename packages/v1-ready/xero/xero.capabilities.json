        "id": "ContactID",
        "updatedAt": "UpdatedDateUTC",
        "list": {
          "capability": "contact.list",
          "cursor": "page",
          "paging": "page",
          "since": "ifModifiedSince",
          "items": "Contacts"
        },
        "get": {
          "capability": "contact.get",
          "id": "contactId"
        },
        "create": {
          "capability": "contact.create"
        },
        "update": {
