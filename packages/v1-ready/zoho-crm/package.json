    "dotenv": "^16.0.3",
    "eslint": "^8.22.0",
    "prettier": "^2.7.1",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@friggframework/core": "^2.0.0-next.68"
  },
  "publishConfig": {
    "access": "public"
