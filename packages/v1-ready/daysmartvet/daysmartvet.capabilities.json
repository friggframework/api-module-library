        { "name": "reason", "tags": ["required"] },
        { "name": "start", "tags": ["timestamp", "required"] },
        { "name": "end", "tags": ["timestamp", "required"] },
        { "name": "location", "tags": ["enum", "required"] },
        { "name": "note", "tags": [] },
        { "name": "client.id", "tags": [] },
        { "name": "patient.id", "tags": [] },
        { "name": "provider.id", "tags": [] }
