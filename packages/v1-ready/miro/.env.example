# Miro OAuth app credentials (Miro Developer team → Your apps).
# https://developers.miro.com/docs/getting-started-with-oauth
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=

# Space-separated OAuth scopes configured on the app. Defaults in api.js cover
# boards read/write when this is unset.
# Example: boards:read boards:write
MIRO_SCOPE=

# Shared redirect base used by Frigg; the module appends /miro.
# REDIRECT_URI=https://your-app.example.com/redirect
