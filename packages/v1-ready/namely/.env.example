# Namely company subdomain (the {company} in https://{company}.namely.com).
NAMELY_COMPANY=your-company

# Personal Access Token minted under the Namely tenant's API menu.
# Sent as: Authorization: Bearer <token>
# Lifetime is typically 2 years; inherits the creating user's permissions.
# Partners building marketplace apps should prefer a per-tenant OAuth application
# instead — see the PR open questions.
NAMELY_ACCESS_TOKEN=your_namely_personal_access_token
