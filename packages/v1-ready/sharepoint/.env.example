# Azure AD app registration (Microsoft identity platform / Graph)
# Docs: https://learn.microsoft.com/en-us/graph/auth-v2-user
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Space-separated Graph delegated scopes, e.g.:
# offline_access User.Read Sites.Read.All Sites.ReadWrite.All Files.ReadWrite.All
# Permissions reference: https://learn.microsoft.com/en-us/graph/permissions-reference
SHAREPOINT_SCOPE=
# Optional tenant: common | organizations | consumers | {tenant-id}
# Docs: https://learn.microsoft.com/en-us/graph/auth-v2-user
SHAREPOINT_TENANT_ID=common
# Base redirect host; module appends /sharepoint
REDIRECT_URI=http://localhost:3000/redirect

# Webhook extension (Graph change notifications)
# Must match the clientState set on createSubscription
# Docs: https://learn.microsoft.com/en-us/graph/change-notifications-delivery-webhooks
SHAREPOINT_WEBHOOK_CLIENT_STATE=
