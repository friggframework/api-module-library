# Huggg API key (X-Huggg-API-Key). Issued per user within a team during
# integration setup — see https://docs.huggg.me/endpoints/authentication/api-keys/overview/
HUGGG_API_KEY=your_huggg_api_key_here

# Optional: use the sandbox host (https://beta.api.huggg.me) instead of production.
# HUGGG_IS_SANDBOX=true

# Optional override of the API origin (defaults to https://api.huggg.me).
# HUGGG_BASE_URL=https://api.huggg.me
