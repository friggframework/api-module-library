# Zendesk Support OAuth client (Admin Center > Apps and integrations > APIs > OAuth clients).
# For marketplace / multi-account apps Zendesk requires a global OAuth client —
# see https://developer.zendesk.com/documentation/marketplace/building-a-marketplace-app/set-up-a-global-oauth-client/
ZENDESK_CLIENT_ID=your_zendesk_oauth_client_identifier
ZENDESK_CLIENT_SECRET=your_zendesk_oauth_client_secret

# Space-separated scopes. Prefer granular resource scopes over broad "read write".
# Docs: https://developer.zendesk.com/api-reference/ticketing/oauth/grant_type_tokens/#scope
# ZENDESK_SCOPE=tickets:read tickets:write users:read users:write organizations:read organizations:write webhooks:read webhooks:write

# Shared Frigg redirect base; Definition appends /zendesk.
# REDIRECT_URI=https://your-app.example.com/redirect

# Optional: signing secret for inbound webhook verification (Tier-3 extension).
# Prefer the per-webhook secret from GET /api/v2/webhooks/{id}/signing_secret.
# ZENDESK_WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret
