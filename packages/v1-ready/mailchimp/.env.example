# --- OAuth 2.0 (primary; required for Mailchimp Marketplace) ---
# Register an app: https://us1.admin.mailchimp.com/account/oauth2/
# Authorize: https://login.mailchimp.com/oauth2/authorize
# Token:     https://login.mailchimp.com/oauth2/token
# Metadata:  https://login.mailchimp.com/oauth2/metadata  (Authorization: OAuth <token>)
# Docs: https://mailchimp.com/developer/marketing/guides/access-user-data-oauth-2/
MAILCHIMP_CLIENT_ID=your_oauth_client_id
MAILCHIMP_CLIENT_SECRET=your_oauth_client_secret
# REDIRECT_URI is the Frigg app base; definition appends /mailchimp
REDIRECT_URI=https://your-frigg-app.example.com/redirect

# --- API key (optional; for single-account / local testing) ---
# Format: <key>-<dc>  e.g. abcdef0123456789abcdef0123456789-us6
# Authorization: Bearer <api_key>
# Docs: https://mailchimp.com/developer/marketing/docs/fundamentals/
# MAILCHIMP_API_KEY=your_api_key_here-us6

# Optional full Marketing API base URL override (e.g. https://us6.api.mailchimp.com/3.0)
# when not discoverable from OAuth metadata or the API key suffix.
# MAILCHIMP_BASE_URL=https://us6.api.mailchimp.com/3.0

# Signing secret returned once when creating a list webhook (signing_enabled).
# Used by extensions/webhooks for X-Mailchimp-Signature verification.
# Docs: https://mailchimp.com/developer/marketing/guides/sync-audience-data-webhooks/
# MAILCHIMP_WEBHOOK_SECRET=your_webhook_signing_secret
