# BambooHR API key auth (HTTP Basic: username = API key, password = any string).
# Generate a key in BambooHR: user menu → API Keys.
BAMBOOHR_API_KEY=

# Company subdomain (the {companyDomain} in https://{companyDomain}.bamboohr.com).
BAMBOOHR_COMPANY_DOMAIN=

# Optional password for the Basic auth pair. BambooHR accepts any string; docs use "x".
BAMBOOHR_API_PASSWORD=x

# Private key returned once by POST /api/v1/webhooks (createWebhook). Used to verify
# X-BambooHR-Signature on inbound permissioned webhook deliveries.
BAMBOOHR_WEBHOOK_PRIVATE_KEY=
