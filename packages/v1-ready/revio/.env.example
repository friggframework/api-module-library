# Rev.io Basic auth credentials.
# Authorization header is Base64(username@client_code:password).
# Docs: https://developers.rev.io/docs/basic-authentication
REVIO_USERNAME=your_api_username
REVIO_PASSWORD=your_api_password
REVIO_CLIENT_CODE=your_client_code

# Optional override. Default: https://restapi.rev.io/v1
# (Getting Started / Basic Authentication). Some newer OpenAPI embeds use
# https://api.revioapi.com — set REVIO_BASE_URL if your tenant requires it.
# REVIO_BASE_URL=https://restapi.rev.io/v1
