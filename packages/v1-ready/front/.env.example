# Front OAuth application credentials (Developers page → Features → OAuth).
# Scopes / namespaces / permissions are configured on the app in Front, not
# passed as authorize-query params (see https://dev.frontapp.com/docs/oauth).
FRONT_CLIENT_ID=
FRONT_CLIENT_SECRET=

# Shared with other Frigg modules — callback path is /front.
REDIRECT_URI=https://localhost:3000/redirect

# Alternate auth: Front API token (Settings → Developers → API tokens).
# Sent as Authorization: Bearer. Prefer OAuth for public App Store apps.
FRONT_API_TOKEN=

# Application webhook signing secret (Webhook feature → signing / app secret).
# Used by Api.verifyWebhookSignature and extensions/webhooks.
FRONT_WEBHOOK_SECRET=
