# Google Cloud OAuth client for Google Analytics Data API
# https://developers.google.com/analytics/devguides/reporting/data/v1/rest
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=

# Prefer a dedicated redirect URI registered for this module.
# Falls back to ${REDIRECT_URI}/google-analytics when unset.
GOOGLE_ANALYTICS_REDIRECT_URI=
REDIRECT_URI=

# Space-separated OAuth scopes. Default is analytics.readonly.
# Add userinfo.email / userinfo.profile (or openid) if you need Google
# account identity via oauth2/v2/userinfo.
GOOGLE_ANALYTICS_SCOPE=https://www.googleapis.com/auth/analytics.readonly
