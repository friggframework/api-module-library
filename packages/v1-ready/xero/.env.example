# Xero OAuth2 app credentials (https://developer.xero.com/app/manage)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Space-separated scopes. offline_access is required for refresh tokens.
XERO_SCOPE=openid profile email offline_access accounting.transactions accounting.contacts accounting.settings
# Must match a redirect URI registered on the Xero app.
REDIRECT_URI=http://localhost:3000/redirect
# Optional: webhook signing key from the Xero Developer Portal (not the OAuth secret).
XERO_WEBHOOK_KEY=
