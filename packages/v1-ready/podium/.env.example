PODIUM_CLIENT_ID=
PODIUM_CLIENT_SECRET=
# Scope names are not published publicly. Copy them from your app's own
# configuration in the Podium developer portal. Space-separated.
PODIUM_SCOPE=
# Podium requires https for redirect targets, including locally.
REDIRECT_URI=https://localhost:3000/redirect

# Optional overrides. Defaults are api.podium.com/v4 and
# accounts.podium.com/oauth/token — see the "verified vs inferred" section of
# the README. Set these to correct a path or host without a release.
PODIUM_BASE_URL=
PODIUM_TOKEN_URI=
PODIUM_AUTHORIZATION_URI=
