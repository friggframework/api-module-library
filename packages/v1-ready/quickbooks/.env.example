# QuickBooks Online OAuth 2.0 (from https://developer.intuit.com app Keys & OAuth)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Default scope for Accounting API. Add com.intuit.quickbooks.payment if Payments is used.
QUICKBOOKS_SCOPE=com.intuit.quickbooks.accounting
# Shared Frigg redirect base; module appends /quickbooks
REDIRECT_URI=https://localhost:3000/redirect

# sandbox | production (selects API host)
QUICKBOOKS_ENVIRONMENT=sandbox

# Webhook verifier token from the Intuit developer portal Webhooks tab
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
