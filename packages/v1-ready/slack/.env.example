# Slack app credentials from https://api.slack.com/apps → Basic Information / OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Bot token scopes, space-separated (configured on the Slack app). Example for this module's core methods:
# channels:history channels:manage channels:read chat:write files:read groups:history groups:read im:history im:read mpim:history mpim:read users:read users:read.email
SLACK_SCOPE=
# Optional user-token scopes (oauth.v2 user_scope). Leave empty for bot-only installs.
SLACK_USER_SCOPE=
# Shared Frigg redirect base; module appends /slack
REDIRECT_URI=https://localhost:3000/redirect

# Signing secret from Basic Information → App Credentials (Events API / interactivity verification)
SLACK_SIGNING_SECRET=
