# OAuth application registered on the ServiceNow instance
# (System OAuth → Application Registry → Create an OAuth API endpoint for external clients)
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# Optional. Core Yokohama auth-code docs omit scope; some Postman/blog walks use useraccount.
SERVICENOW_SCOPE=
# Frigg redirect base (module appends /servicenow)
REDIRECT_URI=http://localhost:3000/redirect

# Optional basic-auth alternate (instance username/password). Prefer OAuth in production.
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Instance subdomain only, e.g. "dev12345" for https://dev12345.service-now.com
SERVICENOW_INSTANCE=
