{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "vitally",
  "label": "Vitally",
  "package": "@friggframework/api-module-vitally",
  "version": "1.0.0",
  "auth": {
    "type": "basic",
    "scheme": "basic",
    "testAuthRequest": "testAuth",
    "scopesDocumentedAt": "https://docs.vitally.io/en/articles/9880649-rest-api-overview",
    "notes": [
      "HTTP Basic: REST API key as username, empty password.",
      "US host: https://{subdomain}.rest.vitally.io/resources",
      "EU host: https://rest.vitally-eu.io/resources (set base_url)."
    ]
  },
  "source": {
    "officialDocs": "https://docs.vitally.io/en/collections/10410457-rest-api",
    "overview": "https://docs.vitally.io/en/articles/9880649-rest-api-overview",
    "notes": [
      "Demand-source customer-success / account-health module. READ-first curated subset transcribed from official Help Center articles.",
      "Vitally does not publish a provider OpenAPI; vitally.openapi.yaml is a Frigg-curated contract.",
      "No REST API for webhook subscription management was found in official docs."
    ]
  },
  "objects": {
