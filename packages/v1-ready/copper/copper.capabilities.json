{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "copper",
  "label": "Copper CRM",
  "package": "@friggframework/api-module-copper",
  "version": "1.0.0",
  "auth": "apiKey",
  "account": {
    "description": "Values about the connected Copper account, from GET /account and persisted credentials.",
    "fields": [
      {
        "name": "user_email",
        "type": "email",
        "description": "Email of the API key owner (X-PW-UserEmail)"
      }
    ]
  },
  "objects": {
    "person": {
      "label": "Person",
      "fields": [
        { "name": "id", "type": "id", "readOnly": true },
        { "name": "name", "type": "string", "tag": "person.fullName" },
        { "name": "first_name", "type": "string", "tag": "person.givenName" },
        { "name": "last_name", "type": "string", "tag": "person.familyName" },
        { "name": "emails[0].email", "type": "email", "tag": "contact.email" },
        { "name": "phone_numbers[0].number", "type": "phone", "tag": "contact.phone" },
        { "name": "title", "type": "string", "tag": "person.title" },
        { "name": "company_id", "type": "string" },
        { "name": "assignee_id", "type": "string", "tag": "record.owner" },
        {
          "name": "date_created",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "date_modified",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "id",
        "updatedAt": "date_modified",
        "list": {
          "capability": "person.list",
          "cursor": "page_number",
          "limit": "page_size",
          "items": "$",
          "paging": "page"
        },
        "get": { "capability": "person.get", "id": "id" },
        "create": { "capability": "person.create", "body": "person" },
        "update": { "capability": "person.update", "id": "id", "body": "person" }
      }
    },
    "company": {
