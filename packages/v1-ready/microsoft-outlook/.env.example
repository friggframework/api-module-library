# Azure AD / Entra app registration (Microsoft identity platform / Graph)
# https://learn.microsoft.com/en-us/graph/auth-v2-user
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Space-separated Graph delegated scopes. Override as needed for your app.
OUTLOOK_SCOPE=openid offline_access User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite
# Multi-tenant default; set to a directory (tenant) id for single-tenant apps.
OUTLOOK_TENANT_ID=common
# Shared Frigg redirect base; module appends /microsoft-outlook
REDIRECT_URI=https://localhost:3000/redirect
# Optional: expected clientState for Graph change-notification webhooks
OUTLOOK_WEBHOOK_CLIENT_STATE=
