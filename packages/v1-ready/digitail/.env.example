# Digitail OAuth 2.0 (Authorization Code + PKCE) credentials.
# Request API access at https://documentation.digitail.io/getting-access
# Docs: https://documentation.digitail.io/6-ex-authentication
DIGITAIL_CLIENT_ID=your_digitail_client_id
DIGITAIL_CLIENT_SECRET=your_digitail_client_secret

# Dedicated redirect URI registered with Digitail (must match exactly).
DIGITAIL_REDIRECT_URI=https://your-app.example.com/redirect/digitail

# Optional: override hosts (module defaults are production).
# New partners start in sandbox — set both:
# DIGITAIL_API_BASE_URL=https://developer.digitail.io/api/v1
# DIGITAIL_OAUTH_HOST=https://developer.digitail.io
# Production:
# DIGITAIL_API_BASE_URL=https://vet.digitail.io/api/v1
# DIGITAIL_OAUTH_HOST=https://vet.digitail.io

# Optional: default clinic context for X-ClinicId header.
# DIGITAIL_CLINIC_ID=123
