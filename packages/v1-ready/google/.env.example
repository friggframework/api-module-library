# Google OAuth 2.0 client (Cloud Console → APIs & Services → Credentials).
# Authorize: https://accounts.google.com/o/oauth2/v2/auth
# Token: https://oauth2.googleapis.com/token
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Dedicated redirect URI for this module (must match the Cloud Console client).
GOOGLE_REDIRECT_URI=https://your-app.example.com/redirect/google

# Optional space-separated scope override. Default covers openid/email/profile
# plus Gmail, Calendar, Drive, Docs, Sheets, Analytics, Search Console, Ads.
# GOOGLE_SCOPE=openid email profile https://www.googleapis.com/auth/gmail.modify ...

# Optional Google Ads developer token (header ignored after 2026-09-09 sunset;
# still accepted for older clients). Prefer Cloud project access levels.
# GOOGLE_ADS_DEVELOPER_TOKEN=
