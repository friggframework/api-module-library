        { "name": "name", "tags": ["display", "required"] },
        { "name": "description", "tags": [] },
        { "name": "domains", "tags": [] },
        { "name": "note", "tags": [] },
        { "name": "health_score", "tags": [] },
        { "name": "account_tier", "tags": [] },
        { "name": "renewal_date", "tags": ["timestamp"] },
        { "name": "created_at", "tags": ["timestamp"] },
        { "name": "updated_at", "tags": ["timestamp"] }
      ],
      "capabilities": {
        "list": {
          "method": "listCompanies",
          "spec": "freshdesk.openapi.yaml#/paths/~1companies/get"
        },
        "get": {
          "method": "getCompany",
          "spec": "freshdesk.openapi.yaml#/paths/~1companies~1{id}/get"
        },
        "create": {
          "method": "createCompany",
          "spec": "freshdesk.openapi.yaml#/paths/~1companies/post"
        },
        "update": {
          "method": "updateCompany",
          "spec": "freshdesk.openapi.yaml#/paths/~1companies~1{id}/put"
        }
      }
    }
  },
  "skipped": {
    "webhooks": {
      "reason": "Freshdesk outbound webhooks are configured as Trigger Webhook / Trigger API actions inside Admin → Workflows → Automations. There is no public REST create/list/delete subscription API for webhook endpoints.",
      "docs": "https://support.freshdesk.com/support/solutions/articles/132589-using-webhooks-in-automation-rules"
    },
    "conversations": {
      "reason": "Ticket conversations / replies are available via the API but deferred from this first cut; use include=conversations on getTicket or the dedicated conversations endpoints in a follow-up.",
      "docs": "https://developers.freshdesk.com/api/#conversations"
    },
    "delete": {
      "reason": "Delete endpoints exist for tickets/contacts/companies/agents but are omitted from the core list/get/create/update surface for this first cut.",
      "docs": "https://developers.freshdesk.com/api/"
    }
  }
