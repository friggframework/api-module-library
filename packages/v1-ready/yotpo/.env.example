# Yotpo Core API credentials (Store Settings → General Settings).
# Store ID is also called the app key.
# Docs: https://core-api.yotpo.com/reference/authentication
#        https://support.yotpo.com/docs/finding-your-yotpo-app-key-and-secret-key
YOTPO_STORE_ID=your_store_id_or_app_key
YOTPO_API_SECRET=your_api_secret

# Optional: reuse a previously generated access token (X-Yotpo-Token).
# If omitted, the module exchanges store_id + secret via POST .../access_tokens.
YOTPO_ACCESS_TOKEN=
