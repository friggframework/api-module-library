# ActiveCampaign API Access Key (Settings → Developer).
# Sent on every request as the `Api-Token` header.
ACTIVECAMPAIGN_API_KEY=your_api_key_here

# Account-specific API Access URL from the same Developer tab.
# Example: https://youraccountname.api-us1.com
# Do NOT invent a host from an account slug — always use the Developer-tab URL.
ACTIVECAMPAIGN_API_URL=https://youraccountname.api-us1.com
