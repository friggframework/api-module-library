# OAuth 2.0 (recommended for multi-customer integrations)
CLOSE_CLIENT_ID=
CLOSE_CLIENT_SECRET=
# Official scopes granted to Close OAuth apps (see developer docs)
CLOSE_SCOPE=all.full_access offline_access
REDIRECT_URI=https://localhost:3000/redirect

# API key alternate (HTTP Basic: api_key as username, empty password)
CLOSE_API_KEY=

# Optional: webhook HMAC hex signature_key for verifying close-sig-hash
CLOSE_WEBHOOK_SIGNATURE_KEY=
