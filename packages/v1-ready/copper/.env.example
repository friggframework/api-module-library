# Copper CRM Developer API credentials.
# Generate an API key in Copper under System settings > API Keys.
# Sent as X-PW-AccessToken together with X-PW-UserEmail and
# X-PW-Application: developer_api on every request.
# Docs: https://developer.copper.com/introduction/authentication.html
COPPER_API_KEY=your_copper_api_key_here
COPPER_USER_EMAIL=token.owner@example.com

# Optional: shared secret field value checked by the inbound webhook
# receiver when subscriptions are created with a `secret` object.
# Docs: https://developer.copper.com/webhooks/overview.html
COPPER_WEBHOOK_SECRET=your_webhook_secret_value

# Optional: expected Authorization (or custom) header value when
# subscriptions are created with `headers`. Example: "Bearer token"
COPPER_WEBHOOK_AUTH_HEADER=
