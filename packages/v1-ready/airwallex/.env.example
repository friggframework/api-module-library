# Airwallex API credentials (sandbox or production).
# Create under Airwallex web app → Account → Developer → API keys.
# Docs: https://www.airwallex.com/docs/developer-tools/api/manage-api-keys
AIRWALLEX_CLIENT_ID=your_client_id
AIRWALLEX_API_KEY=your_api_key

# Optional. Defaults to production https://api.airwallex.com
# Sandbox: https://api.sandbox.airwallex.com
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# Optional. Account id for scoped keys linked to multiple accounts (x-login-as).
# AIRWALLEX_LOGIN_AS=acct_...
