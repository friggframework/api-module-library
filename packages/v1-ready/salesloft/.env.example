# Salesloft OAuth application credentials (Authorization Code grant).
# Create an app under Your Applications → OAuth Applications in Salesloft.
# Docs: https://developers.salesloft.com/docs/platform/api-basics/oauth-authentication/
SALESLOFT_CLIENT_ID=your_salesloft_client_id
SALESLOFT_CLIENT_SECRET=your_salesloft_client_secret

# Shared Frigg redirect base; the module appends /salesloft.
REDIRECT_URI=https://localhost:3000/redirect

# Optional: shared secret used when verifying inbound webhook deliveries
# (must match the callback_token registered on the webhook subscription).
# Docs: https://developers.salesloft.com/docs/platform/webhooks/delivery-headers/
SALESLOFT_WEBHOOK_CALLBACK_TOKEN=your_webhook_callback_token
