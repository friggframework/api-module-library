{
  "schema": "capability-manifest/v0.1",
  "module": "daysmartvet",
  "package": "@friggframework/api-module-daysmartvet",
  "version": "1.0.0",
  "auth": {
    "type": "oauth2",
    "grant": "client_credentials",
    "scope": "APIService",
    "methods": {
      "getToken": "getTokenFromClientCredentials",
      "testAuth": "getClinic"
    },
    "credentials": ["client_id", "client_secret", "api_key"],
    "docs": "https://sandbox.vettersoftware.com/docs/"
  },
  "objects": {
