{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "klaviyo",
  "label": "Klaviyo",
  "package": "@friggframework/api-module-klaviyo",
  "version": "1.0.0",
  "auth": "oauth2",
  "objects": {
    "profile": {
      "label": "Profile",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "attributes.email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "attributes.phone_number",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "attributes.first_name",
          "type": "string",
          "tag": "person.givenName"
        },
        {
          "name": "attributes.last_name",
          "type": "string",
          "tag": "person.familyName"
        },
        {
          "name": "attributes.organization",
          "type": "string",
          "tag": "organization.name"
        },
        {
          "name": "attributes.title",
          "type": "string",
          "tag": "person.jobTitle"
        },
        {
          "name": "attributes.external_id",
          "type": "string",
          "tag": "record.externalId"
        },
        {
          "name": "attributes.location.city",
          "type": "string",
          "tag": "address.locality"
        },
        {
          "name": "attributes.location.region",
          "type": "string",
          "tag": "address.region"
        },
        {
          "name": "attributes.location.country",
          "type": "string",
          "tag": "address.country"
        },
        {
          "name": "attributes.location.zip",
          "type": "string",
          "tag": "address.postalCode"
        },
        {
          "name": "attributes.subscriptions.email.marketing.consent",
          "type": "enum",
          "tag": "contact.emailConsent",
          "values": [
            "SUBSCRIBED",
            "UNSUBSCRIBED",
            "NEVER_SUBSCRIBED"
          ],
          "readOnly": true
        },
        {
          "name": "attributes.properties.lifetime_value",
          "type": "number",
          "tag": "customer.lifetimeValue"
        },
        {
          "name": "attributes.properties.shopify_tags",
          "type": "string",
          "tag": "record.tags"
        },
        {
          "name": "attributes.properties.hubspot_lifecycle_stage",
          "type": "string",
          "tag": "contact.lifecycleStage"
        },
        {
          "name": "attributes.created",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "attributes.updated",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "id",
        "updatedAt": "attributes.updated",
        "list": {
          "capability": "profile.list",
          "cursor": "pageCursor",
          "limit": "pageSize",
          "since": "updatedSince",
          "items": "data",
          "next": "links.next"
        },
        "get": {
          "capability": "profile.get",
          "id": "id"
        },
        "search": {
          "capability": "profile.search"
        },
        "create": {
          "capability": "profile.create",
          "body": "attributes"
        },
        "update": {
          "capability": "profile.update",
          "id": "id",
          "body": "attributes"
        }
      }
    },
    "list": {
      "label": "List",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "attributes.name",
          "type": "string",
          "tag": "list.name"
        },
        {
          "name": "attributes.created",
          "type": "datetime",
          "readOnly": true
        }
      ]
    },
    "event": {
      "label": "Event",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "attributes.metric_name",
          "type": "string"
        },
        {
          "name": "attributes.properties",
          "type": "json"
        },
        {
          "name": "attributes.value",
          "type": "number"
        },
        {
          "name": "attributes.time",
          "type": "datetime"
        },
        {
          "name": "attributes.unique_id",
          "type": "string"
        }
      ]
    }
  },
  "events": {
    "profile.subscribed_email_marketing": {
      "delivery": "webhook",
      "object": "profile",
      "subscribe": "webhook.create",
      "description": "Official common webhook topic event:klaviyo.subscribed_to_email_marketing — when a profile consents to email marketing.",
      "payload": {
        "id": "01JAEXAMPLE7Q9VK3D6M2N8P4R",
        "topic": "event:klaviyo.subscribed_to_email_marketing",
        "created_at": "2026-10-18T16:02:11Z",
        "data": {
          "type": "event",
          "id": "4vRpBT",
          "attributes": {
            "metric_name": "Subscribed to Email Marketing",
            "datetime": "2026-10-18T16:02:10Z",
            "event_properties": {
              "method": "Signup form"
            }
          },
          "profile": {
            "type": "profile",
            "id": "01HV6N2Y4K9JQ3ZB8XWQ7T5R2M",
            "email": "dana.reyes@example.com",
            "phone_number": "+15125550142",
            "first_name": "Dana",
            "last_name": "Reyes",
            "organization": "Reyes Coffee Co",
            "external_id": "7012345678901"
          }
        }
      },
      "record": "data.profile",
      "match": "event:klaviyo.subscribed_to_email_marketing"
    },
    "profile.unsubscribed_email_marketing": {
      "delivery": "webhook",
      "object": "profile",
      "subscribe": "webhook.create",
      "description": "Official common webhook topic event:klaviyo.unsubscribed_from_email_marketing — global email marketing unsubscribe.",
      "payload": {
        "id": "01JAEXAMPLE7Q9VK3D6M2N8P4R",
        "topic": "event:klaviyo.unsubscribed_from_email_marketing",
        "created_at": "2026-10-18T16:02:11Z",
        "data": {
          "type": "event",
          "id": "4vRpBT",
          "attributes": {
            "metric_name": "Unsubscribed from Email Marketing",
            "datetime": "2026-10-18T16:02:10Z",
            "event_properties": {
              "method": "Unsubscribe link"
            }
          },
          "profile": {
            "type": "profile",
            "id": "01HV6N2Y4K9JQ3ZB8XWQ7T5R2M",
            "email": "dana.reyes@example.com",
            "phone_number": "+15125550142",
            "first_name": "Dana",
            "last_name": "Reyes",
            "organization": "Reyes Coffee Co",
            "external_id": "7012345678901"
          }
        }
      },
      "record": "data.profile",
      "match": "event:klaviyo.unsubscribed_from_email_marketing"
    },
    "profile.updated": {
      "delivery": "poll",
      "object": "profile",
      "description": "Polled from GET /api/profiles?filter=greater-than(updated,<cursor>).",
      "payload": {
        "type": "profile",
        "id": "01HV6N2Y4K9JQ3ZB8XWQ7T5R2M",
        "attributes": {
          "email": "dana.reyes@example.com",
          "first_name": "Dana",
          "last_name": "Reyes",
          "updated": "2026-10-18T17:00:00Z"
        }
      }
    }
  },
  "webhook": {
    "scope": "installation",
    "topic": "{{body.topic}}",
    "eventId": "{{body.id}}",
    "verify": "extensions/webhooks/signature-verifier.verifyKlaviyoSignature"
  },
  "capabilities": {
    "profile.get": {
      "kind": "read",
      "method": "getProfile",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "additionalFields": {
          "type": "array"
        }
      },
      "output": "profile"
    },
    "profile.search": {
      "kind": "search",
      "method": "listProfiles",
      "input": {
        "email": {
          "type": "string"
        },
        "phone_number": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        }
      },
      "output": "profile[]",
      "notes": "Official search is GET /api/profiles with filter (e.g. equals(email,'…')). Lefthook method name was getProfiles; wired to listProfiles."
    },
    "profile.list": {
      "kind": "read",
      "method": "listProfiles",
      "input": {
        "updatedSince": {
          "type": "string"
        },
        "pageCursor": {
          "type": "string"
        },
        "pageSize": {
          "type": "number"
        }
      },
      "output": "page<profile>"
    },
    "profile.create": {
      "kind": "write",
      "method": "createProfile",
      "input": {
        "attributes": {
          "type": "object",
          "required": true
        }
      },
      "output": "profile"
    },
    "profile.update": {
      "kind": "write",
      "method": "updateProfile",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "attributes": {
          "type": "object",
          "required": true
        }
      },
      "output": "profile"
    },
    "profile.upsert": {
      "kind": "write",
      "method": "createOrUpdateProfile",
      "input": {
        "attributes": {
          "type": "object",
          "required": true
        }
      },
      "output": "profile"
    },
    "profile.lists": {
      "kind": "read",
      "method": "getProfileLists",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "list[]"
    },
    "profile.subscribe": {
      "kind": "write",
      "method": "subscribeProfiles",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "email": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "channels": {
          "type": "array"
        }
      },
      "output": "void"
    },
    "profile.unsubscribe": {
      "kind": "write",
      "method": "unsubscribeProfiles",
      "input": {
        "email": {
          "type": "string",
          "required": true
        },
        "listId": {
          "type": "string"
        }
      },
      "output": "void"
    },
    "list.list": {
      "kind": "read",
      "method": "listLists",
      "input": {},
      "output": "list[]",
      "notes": "Lefthook method name was getLists; wired to listLists (official get_lists)."
    },
    "list.addProfiles": {
      "kind": "write",
      "method": "addProfilesToList",
      "input": {
        "listId": {
          "type": "string",
          "required": true
        },
        "profileIds": {
          "type": "array",
          "required": true
        }
      },
      "output": "void"
    },
    "event.create": {
      "kind": "write",
      "method": "createEvent",
      "input": {
        "metric": {
          "type": "string",
          "required": true
        },
        "profile": {
          "type": "object",
          "required": true
        },
        "properties": {
          "type": "object"
        },
        "value": {
          "type": "number"
        },
        "time": {
          "type": "string"
        },
        "uniqueId": {
          "type": "string"
        }
      },
      "output": "void"
    },
    "webhook.create": {
      "kind": "subscribe",
      "method": "createWebhook",
      "input": {
        "name": {
          "type": "string",
          "required": true
        },
        "endpointUrl": {
          "type": "string",
          "required": true
        },
        "topics": {
          "type": "array",
          "required": true
        },
        "secretKey": {
          "type": "string"
        }
      },
      "output": "webhook"
    },
    "webhook.delete": {
      "kind": "delete",
      "method": "deleteWebhook",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "void"
    }
  },
  "options": {
    "list": {
      "capability": "list.list",
      "label": "{{item.attributes.name}}",
      "value": "$.item.id"
    }
  },
  "openQuestions": {
    "pkceStatePacking": "PKCE code_verifier is packed into OAuth `state` (Salesforce-style) so it survives the browser redirect. Klaviyo docs recommend a server-side store keyed by customer id; confirm whether Frigg auth hosts prefer DB-backed verifier storage over state packing.",
    "oauthConfidentialClient": "Token exchange uses Basic Auth with client_id:client_secret (verified in set_up_oauth). Public-client-only installs without a secret were not verified.",
    "listSubscribeTopic": "Lefthook used event:klaviyo.subscribed_to_list; that id is not in Klaviyo's published common topics table. Manifest events now use event:klaviyo.subscribed_to_email_marketing / event:klaviyo.unsubscribed_from_email_marketing. Account-specific topics (including list subscribe) still available via listWebhookTopics.",
    "customProfileProperties": "attributes.properties.lifetime_value / shopify_tags / hubspot_lifecycle_stage are free-form custom properties (not fixed OpenAPI fields); kept from lefthook for ontology tags.",
    "eventFields": "objects.event.fields (metric_name, properties, value, time, unique_id) mirror create-oriented / lefthook shape; GET event responses use timestamp, datetime, event_properties, uuid per official OpenAPI.",
    "unsubscribeGlobal": "Official bulk_unsubscribe_profiles docs warn that profiles not in the specified list are globally unsubscribed — callers must verify list membership first.",
    "systemWebhooksAccess": "System Webhooks API is limited to Advanced KDP customers and Klaviyo app partners per vendor docs."
  }
}
