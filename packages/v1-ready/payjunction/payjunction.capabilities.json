{
  "schema": "capability-manifest/v0.1",
  "module": "payjunction",
  "package": "@friggframework/api-module-payjunction",
  "version": "1.0.0",
  "auth": {
    "type": "oauth2",
    "grant": "authorization_code",
    "tokenAuth": "http_basic_client_credentials",
    "apiAuth": "bearer_plus_application_key",
    "headers": ["Authorization", "X-PJ-Application-Key"],
    "scope": "read write",
    "scopeStatus": "UNVALIDATED",
    "identityMethod": "GET /merchant → id (Pj-Merchant)",
    "entityKey": "id",
    "credentialFields": [
      "access_token",
      "refresh_token",
      "accessTokenExpire",
      "refreshTokenExpire",
      "app_key"
    ],
    "authorizeUrl": "https://www.payjunction.com/trinity/oauth/authorize",
    "tokenUrl": "https://www.payjunction.com/trinity/oauth/token",
    "docs": "https://developer.payjunction.com/hc/en-us/articles/218162588-User-Authentication",
    "notes": "Public developer portal documents HTTP Basic (apiLogin:apiPassword) + Application Key. This module ports partner Trinity OAuth2 (Bearer + Application Key) from the Left Hook source."
  },
  "objects": {
