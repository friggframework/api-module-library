# Trello API key — generate under Power-Up admin → Trello Auth
# https://trello.com/apps/admin
TRELLO_API_KEY=your_trello_api_key_here

# User token — authorize at:
# https://trello.com/1/authorize?expiration=never&scope=read,write,account&response_type=token&key=YOUR_API_KEY
TRELLO_TOKEN=your_trello_user_token_here

# Application secret (OAuth 1.0 secret) — used to verify X-Trello-Webhook signatures.
# Same Power-Up admin → Trello Auth tab.
TRELLO_API_SECRET=your_trello_api_secret_here
