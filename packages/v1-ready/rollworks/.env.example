# RollWorks / AdRoll ABM (NextRoll) OAuth 2.0 app credentials.
# Register an application at https://developers.nextroll.com/
# Docs: https://apidocs.nextroll.com/guides/oauth.html
#
# Supported scope today is only `all` (default if omitted).
ROLLWORKS_CLIENT_ID=your_rollworks_client_id
ROLLWORKS_CLIENT_SECRET=your_rollworks_client_secret
ROLLWORKS_SCOPE=all
# Shared Frigg redirect base; the module appends /rollworks.
REDIRECT_URI=https://localhost:3000/redirect
