# JobTread grant key from Settings → Integrations → API → Grants
# (app.jobtread.com/settings/integrations/api/grants). Shown once on create.
# Auth is sent in the Pave request body as query.$.grantKey (not a header).
# Grant keys expire after 3 months of inactivity.
JOBTREAD_GRANT_KEY=grant_your_key_here
