# Intercom OAuth app credentials (Developer Hub → Basic Information)
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# Shared Frigg redirect base; module appends /intercom
REDIRECT_URI=https://localhost:3000/redirect

# Optional: pin API host (defaults to https://api.intercom.io).
# Regional hosts: https://api.eu.intercom.io, https://api.au.intercom.io
INTERCOM_BASE_URL=

# Optional: OAuth authorize host (defaults to https://app.intercom.com).
# Regional hosts: https://app.eu.intercom.com, https://app.au.intercom.com
INTERCOM_AUTH_HOST=

# Optional: API version header (defaults to 2.17 — newest stable OpenAPI pin)
INTERCOM_API_VERSION=2.17

# Webhook HMAC secret = app client_secret (X-Hub-Signature)
INTERCOM_WEBHOOK_SECRET=
