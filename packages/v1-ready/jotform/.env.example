# Jotform API key.
# Generate under My Account → API → Create New Key.
# Sent on every request as the `APIKEY` header.
# https://api.jotform.com/docs/
# https://www.jotform.com/help/253-how-to-create-a-jotform-api-key/
JOTFORM_API_KEY=your_jotform_api_key_here

# Optional. Defaults to https://api.jotform.com (US).
# EU: https://eu-api.jotform.com
# HIPAA: https://hipaa-api.jotform.com
# Enterprise: your-domain.com/API or subdomain.jotform.com/API
# JOTFORM_BASE_URL=https://api.jotform.com
