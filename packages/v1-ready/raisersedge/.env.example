# Blackbaud SKY application credentials (Developer Portal).
# https://developer.blackbaud.com/skyapi/docs/authorization
BLACKBAUD_CONSUMER_KEY=
BLACKBAUD_CONSUMER_SECRET=

# Space-delimited OAuth scopes configured on the SKY application.
# Example (Raiser's Edge NXT): rnxt.r rnxt.w rnxt.d rnxt.whk
# https://developer.blackbaud.com/skyapi/docs/authorization/app-registration/application-scopes
BLACKBAUD_SCOPE=

# Dedicated OAuth redirect URI registered on the SKY application (full URL).
# Do not derive from REDIRECT_URI — use this env var only.
RAISERSEDGE_REDIRECT_URI=https://your-app.example.com/redirect/raisersedge

# SKY API subscription key (Bb-Api-Subscription-Key header on every API call).
BLACKBAUD_SUBSCRIPTION_KEY=

# Optional shared secret placed on webhook_url as ?webhookKey=… when creating
# subscriptions. Used by the extensions/webhooks receiver to reject deliveries
# that do not present the same key.
BLACKBAUD_WEBHOOK_KEY=
