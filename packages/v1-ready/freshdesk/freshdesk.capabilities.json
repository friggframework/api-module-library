        },
        "get": {
          "method": "getAgent",
          "spec": "freshdesk.openapi.yaml#/paths/~1agents~1{id}/get"
        },
        "me": {
          "method": "getAuthenticatedAgent",
          "spec": "freshdesk.openapi.yaml#/paths/~1agents~1me/get"
        }
      }
    },
    "ticket": {
      "description": "Freshdesk support tickets",
      "fields": [
        { "name": "id", "tags": ["identifier", "required"] },
        { "name": "subject", "tags": ["display", "required"] },
        { "name": "description", "tags": [] },
        { "name": "description_text", "tags": [] },
        { "name": "status", "tags": ["enum"] },
        { "name": "priority", "tags": ["enum"] },
        { "name": "source", "tags": ["enum"] },
