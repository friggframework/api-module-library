        { "name": "id", "tags": ["identifier", "required"] },
        { "name": "name", "tags": ["display", "required"] },
        { "name": "color", "tags": [] },
        { "name": "chip", "tags": [] },
        { "name": "status", "tags": ["enum", "lifecycle"] },
        { "name": "birthdate", "tags": ["timestamp"] },
        { "name": "species.id", "tags": [] },
        { "name": "sex.id", "tags": [] },
        { "name": "breeds", "tags": [] }
      ],
      "capabilities": {
        "list": {
          "method": "listPatients",
          "spec": "daysmartvet.openapi.yaml#/paths/~1api~1.0.0~1{apiKey}~1patients/get"
