# OAuth 2.0 (Covetrus Connect / partner credentials)
COVETRUS_CLIENT_ID=
COVETRUS_CLIENT_SECRET=
# Space-separated scopes. Default matches the ported client surface.
COVETRUS_SCOPE=clients invoices payments
# Dedicated redirect URI for this module (preferred). Fallback: ${REDIRECT_URI}/covetrus
COVETRUS_REDIRECT_URI=https://localhost:3000/redirect/covetrus
REDIRECT_URI=https://localhost:3000/redirect
