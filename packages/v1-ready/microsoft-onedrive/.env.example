# Azure AD app registration (Microsoft identity platform)
MICROSOFT_ONEDRIVE_CLIENT_ID=
MICROSOFT_ONEDRIVE_CLIENT_SECRET=
# Space-separated Graph scopes. Include offline_access for refresh tokens.
# Example: offline_access User.Read Files.ReadWrite
MICROSOFT_ONEDRIVE_SCOPE=offline_access User.Read Files.ReadWrite
# Optional tenant path segment (common | organizations | consumers | tenant id)
MICROSOFT_ONEDRIVE_TENANT_ID=common
# Base redirect host; Definition appends /microsoft-onedrive
REDIRECT_URI=https://localhost:3000/redirect
# Opaque clientState for Graph change-notification subscriptions
MICROSOFT_ONEDRIVE_WEBHOOK_CLIENT_STATE=
