# Atlassian OAuth 2.0 (3LO) app — https://developer.atlassian.com/console/myapps/
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
# Space-separated scopes. Include offline_access for refresh tokens and read:me for /me.
# Granular Confluence scopes (from the official v2 OpenAPI), for example:
# read:me offline_access read:space:confluence write:space:confluence read:page:confluence write:page:confluence delete:page:confluence
CONFLUENCE_SCOPE=
# Shared Frigg redirect base; Definition appends /confluence
REDIRECT_URI=https://localhost:3000/redirect
