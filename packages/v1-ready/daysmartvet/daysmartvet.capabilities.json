        { "name": "label", "tags": ["display"] }
      ],
      "capabilities": {
        "list": {
          "method": "listBreeds",
          "spec": "daysmartvet.openapi.yaml#/paths/~1api~1.0.0~1{apiKey}~1breeds/get"
        }
      }
    }
  },
  "skipped": {
    "webhooks": {
      "reason": "The published DaySmart Vet API reference at https://sandbox.vettersoftware.com/docs/ does not document a webhook subscription REST surface (create/list/delete). No extensions/webhooks/ shipped.",
      "docs": "https://sandbox.vettersoftware.com/docs/"
    },
    "invoiceWrite": {
      "reason": "Official docs expose GET list/get for invoices only — no POST/PUT invoice endpoints are documented.",
      "docs": "https://sandbox.vettersoftware.com/docs/"
    },
    "paymentWrite": {
      "reason": "Official docs expose GET list for payments only — no get-by-id or create/update payment endpoints are documented.",
      "docs": "https://sandbox.vettersoftware.com/docs/"
    },
    "legacyV1ApiKeySurface": {
      "reason": "An earlier Left Hook draft targeted https://api.daysmartvet.com/api/v1 with a standalone X-API-Key + X-Practice-ID header scheme. That host returns 404; the published vendor docs use OAuth2 client_credentials on the execute-api domains with apiKey in the path. The draft surface (ledger, client balance, /species/{id}/breeds, create invoice/payment) was not ported.",
      "docs": "https://sandbox.vettersoftware.com/docs/"
    },
    "inventoryMedicalNotesRemindersStaff": {
      "reason": "Official docs cover many additional resources (inventories, medical-notes, reminders, staffs, estimates, wellness-plans, census, communications, …). Deferred until an integration needs them; core marketplace objects for this cut are clinic/clients/patients/appointments/invoices/payments.",
      "docs": "https://sandbox.vettersoftware.com/docs/"
    }
  }
