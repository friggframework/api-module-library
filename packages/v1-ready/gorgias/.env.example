# Gorgias OAuth2 (required for public apps).
# Create a draft app at https://partners.gorgias.com to obtain credentials.
# Docs: https://developers.gorgias.com/docs/set-up-oauth2-app-store
GORGIAS_CLIENT_ID=your_gorgias_client_id
GORGIAS_CLIENT_SECRET=your_gorgias_client_secret
# Space-separated scopes, e.g.:
# openid email profile offline account:read tickets:read tickets:write customers:read users:read tags:read satisfaction_survey:read integrations:read integrations:write
GORGIAS_SCOPES=openid email profile offline account:read tickets:read tickets:write customers:read customers:write users:read tags:read satisfaction_survey:read integrations:read integrations:write

# Shared Frigg OAuth redirect base (callback path is /gorgias).
REDIRECT_URI=https://your-app.example.com/redirect

# Optional: private-app Basic Auth alternate (email + API key from Settings → REST API).
# GORGIAS_API_USER_EMAIL=agent@example.com
# GORGIAS_API_KEY=your_api_key
# GORGIAS_SUBDOMAIN=your-account
