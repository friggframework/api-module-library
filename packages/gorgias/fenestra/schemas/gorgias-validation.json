{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gorgias Fenestra Validation Schema",
  "description": "Validation schema for Gorgias Fenestra specifications",
  "type": "object",
  "properties": {
    "fenestra": {
      "type": "string",
      "pattern": "^1\.0\.0$"
    },
    "platform": {
      "type": "object",
      "required": ["name", "description"]
    }
  },
  "required": ["fenestra", "platform"]
}
