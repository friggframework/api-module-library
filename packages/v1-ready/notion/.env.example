# Notion public connection (OAuth 2.0) — https://developers.notion.com/guides/get-started/authorization
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional; Notion public connections do not use classic OAuth scopes.
NOTION_SCOPE=
# Shared Frigg redirect base; module appends /notion
REDIRECT_URI=https://localhost:3000/redirect

# Notion-Version header (latest documented: 2026-03-11)
NOTION_VERSION=2026-03-11

# Webhook subscription verification token from Notion connection settings
# (sent once when the subscription is created). Used to verify X-Notion-Signature.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
