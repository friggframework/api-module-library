# Shopify Partner / Dev Dashboard app credentials.
# https://shopify.dev/docs/apps/build/authentication-authorization
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
# Comma-separated Admin API access scopes, e.g.
# read_customers,write_customers,read_orders,write_orders,read_fulfillments,write_fulfillments,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
SHOPIFY_SCOPE=read_customers,write_customers,read_orders,write_orders,read_fulfillments,write_fulfillments,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
# Base redirect URI host; definition appends /shopify
REDIRECT_URI=https://your-app.example.com/redirect
