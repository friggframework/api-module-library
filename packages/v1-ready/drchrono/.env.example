DRCHRONO_CLIENT_ID=
DRCHRONO_CLIENT_SECRET=
# Preferred dedicated redirect URI for this module
DRCHRONO_REDIRECT_URI=https://localhost:3000/redirect/drchrono
# Fallback used only when DRCHRONO_REDIRECT_URI is unset: ${REDIRECT_URI}/drchrono
REDIRECT_URI=
# Default: patients:read patients:write billing:read billing:write
# Add calendar:read calendar:write (and user:read) when using appointments / identity enrichment
DRCHRONO_SCOPE=patients:read patients:write billing:read billing:write
# Webhook secret token from the DrChrono API application webhook UI
DRCHRONO_WEBHOOK_SECRET=
