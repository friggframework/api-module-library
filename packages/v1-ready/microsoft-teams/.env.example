# Azure AD app registration (Microsoft identity platform / Graph)
# https://learn.microsoft.com/en-us/graph/auth-v2-user
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Space-separated Graph delegated scopes. Override as needed for your app.
TEAMS_SCOPE=openid offline_access User.Read Organization.Read.All Team.ReadBasic.All Channel.ReadBasic.All Channel.Create ChannelSettings.ReadWrite.All ChannelMessage.Read.All ChannelMessage.Send Chat.Read Chat.ReadWrite
# Multi-tenant default; set to a directory (tenant) id for single-tenant apps.
TEAMS_TENANT_ID=common
# Shared Frigg redirect base; module appends /microsoft-teams
REDIRECT_URI=https://localhost:3000/redirect
# Optional: expected clientState for Graph change-notification webhooks
TEAMS_WEBHOOK_CLIENT_STATE=
