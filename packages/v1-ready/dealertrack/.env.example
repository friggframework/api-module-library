# Dealertrack (Cox Automotive) OAuth app credentials.
# Partner onboarding via https://developer.coxautoinc.com/ (Opentrack / Integration Platform).
DEALERTRACK_CLIENT_ID=
DEALERTRACK_CLIENT_SECRET=
# Space-separated scopes. Default aligns with Left Hook cleared source notes.
DEALERTRACK_SCOPE=service customers repairs payments
# Dedicated OAuth redirect URI for this module (preferred).
DEALERTRACK_REDIRECT_URI=
# Fallback used only when DEALERTRACK_REDIRECT_URI is unset: ${REDIRECT_URI}/dealertrack
REDIRECT_URI=
