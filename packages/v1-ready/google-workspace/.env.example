# Google Cloud OAuth client (Drive + Calendar scopes)
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
# Space-separated scopes. Defaults in api.js if unset.
GOOGLE_WORKSPACE_SCOPE=

# Prefer a dedicated redirect URI for this module.
GOOGLE_WORKSPACE_REDIRECT_URI=
# Fallback when GOOGLE_WORKSPACE_REDIRECT_URI is unset: ${REDIRECT_URI}/google-workspace
REDIRECT_URI=

# Optional: channel token echoed as X-Goog-Channel-Token on push notifications
GOOGLE_WORKSPACE_WEBHOOK_CHANNEL_TOKEN=
