# Square OAuth application credentials (Developer Console → Applications)
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# Space-separated Square permission scopes. Example core set for this module:
# MERCHANT_PROFILE_READ CUSTOMERS_READ CUSTOMERS_WRITE PAYMENTS_READ PAYMENTS_WRITE INVOICES_READ INVOICES_WRITE
SQUARE_SCOPE=MERCHANT_PROFILE_READ CUSTOMERS_READ CUSTOMERS_WRITE PAYMENTS_READ PAYMENTS_WRITE INVOICES_READ INVOICES_WRITE
# Shared Frigg redirect host; the module appends /square
REDIRECT_URI=https://localhost:3000/redirect
# Optional overrides
# SQUARE_BASE_URL=https://connect.squareupsandbox.com
# SQUARE_VERSION=2026-09-16
