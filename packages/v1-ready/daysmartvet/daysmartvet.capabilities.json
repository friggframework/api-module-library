      "description": "Connected veterinary clinic / practice identity",
      "fields": [
        { "name": "apiKey", "tags": ["identifier", "required"] },
        { "name": "name", "tags": ["display", "required"] },
        { "name": "email", "tags": ["pii"] },
        { "name": "phone", "tags": ["pii"] },
        { "name": "website", "tags": [] },
        { "name": "addresses", "tags": [] }
      ],
      "capabilities": {
        "get": {
          "method": "getClinic",
          "spec": "daysmartvet.openapi.yaml#/paths/~1api~1.0.0~1{apiKey}~1clinic/get"
        }
      }
    },
    "client": {
      "description": "Pet owner / client records",
      "fields": [
        { "name": "id", "tags": ["identifier", "required"] },
        { "name": "firstName", "tags": ["pii", "required"] },
        { "name": "lastName", "tags": ["pii", "required"] },
        { "name": "email", "tags": ["pii"] },
        { "name": "mobile", "tags": ["pii"] },
        { "name": "home", "tags": ["pii"] },
        { "name": "work", "tags": ["pii"] },
        { "name": "address", "tags": ["pii"] },
        { "name": "city", "tags": [] },
        { "name": "state", "tags": [] },
        { "name": "country", "tags": [] },
        { "name": "zipcode", "tags": [] },
        { "name": "status", "tags": ["enum", "lifecycle"] },
        { "name": "createAt", "tags": ["timestamp"] },
        { "name": "updateAt", "tags": ["timestamp"] }
      ],
      "capabilities": {
        "list": {
          "method": "listClients",
          "spec": "daysmartvet.openapi.yaml#/paths/~1api~1.0.0~1{apiKey}~1clients/get"
        },
        "get": {
          "method": "getClient",
          "spec": "daysmartvet.openapi.yaml#/paths/~1api~1.0.0~1{apiKey}~1clients~1{clientId}/get"
        },
        "create": {
          "method": "createClient",
          "spec": "daysmartvet.openapi.yaml#/paths/~1api~1.0.0~1{apiKey}~1clients/post"
