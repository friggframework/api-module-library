# Project API key + secret key (Settings → Projects → General).
# Sent as HTTP Basic: Authorization: Basic base64(api_key:secret_key)
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=

# Region-aware Dashboard REST / Export / Cohorts host.
# US/default: https://amplitude.com
# EU: https://analytics.eu.amplitude.com
# Or set AMPLITUDE_REGION=eu to select the EU host automatically.
AMPLITUDE_BASE_URL=
AMPLITUDE_REGION=

# User Profile API host (US only; not supported in EU).
# Default: https://profile-api.amplitude.com
AMPLITUDE_PROFILE_BASE_URL=
