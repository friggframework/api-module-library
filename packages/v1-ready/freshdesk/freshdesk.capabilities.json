  "skipped": {
    "webhookSubscriptionApi": {
      "reason": "Freshdesk outbound webhooks are configured as Trigger Webhook / Trigger API actions inside Admin → Workflows → Automations. There is no public REST create/list/delete subscription API for webhook endpoints. Inbound handling is provided via extensions/webhooks.",
      "docs": "https://support.freshdesk.com/support/solutions/articles/132589-using-webhooks-in-automation-rules"
    },
    "delete": {
      "reason": "Delete endpoints exist for tickets/contacts/companies/agents/groups/conversations but are omitted from the core list/get/create/update surface for this cut.",
