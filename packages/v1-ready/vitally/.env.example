# Vitally REST API key (Basic auth username; password is empty).
# Create under Settings → Integrations → Vitally REST API.
# Docs: https://docs.vitally.io/en/articles/9880649-rest-api-overview
VITALLY_API_KEY=your_vitally_rest_api_key_here

# US data center subdomain from https://{subdomain}.vitally.io
VITALLY_SUBDOMAIN=yoursubdomain

# Optional absolute base URL override (required for EU: https://rest.vitally-eu.io/resources)
# VITALLY_BASE_URL=https://rest.vitally-eu.io/resources
