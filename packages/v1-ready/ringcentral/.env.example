# RingCentral OAuth app credentials (Developer Console → Credentials)
# https://developers.ringcentral.com/guide/authentication/auth-code-flow
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=

# Optional. RingCentral ignores the OAuth `scope` query param and uses the
# permissions configured on the app instead. Kept for Frigg env parity.
RINGCENTRAL_SCOPE=

# Shared Frigg redirect base; Definition appends `/ringcentral`.
REDIRECT_URI=https://localhost:3000/redirect

# Production (default): https://platform.ringcentral.com
# Sandbox: https://platform.devtest.ringcentral.com
RINGCENTRAL_BASE_URL=
RINGCENTRAL_ENVIRONMENT=production

# Optional Verification-Token echoed as the Verification-Token request header
# on webhook deliveries when set on createSubscription.deliveryMode.
RINGCENTRAL_WEBHOOK_VERIFICATION_TOKEN=
