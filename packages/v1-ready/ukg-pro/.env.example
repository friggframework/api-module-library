# UKG Pro HCM Core REST — Basic Auth + Customer API Key
# Docs: https://developer.ukg.com/hcm/docs/web-service-account
#
# Create a web service account under:
#   System Configuration > Security > Service Account Administration
# Customer API Key and service hostname under:
#   System Configuration > Security > Web Services

UKG_PRO_USERNAME=your_service_account_username
UKG_PRO_PASSWORD=your_service_account_password
UKG_PRO_CUSTOMER_API_KEY=your_five_char_customer_api_key
# Tenant-specific host, e.g. https://servicet.ultipro.com (no trailing slash)
UKG_PRO_BASE_URL=https://servicet.ultipro.com
