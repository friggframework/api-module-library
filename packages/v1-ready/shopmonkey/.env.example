# Shopmonkey API key (Settings → Integration → API Keys).
# Sent on every request as: Authorization: Bearer <key>
# Docs: https://shopmonkey.dev/overview
SHOPMONKEY_API_KEY=your_shopmonkey_api_key_here

# Optional: shared secret for inbound webhook HMAC verification
# (Webhook Standard: webhook-id / webhook-timestamp / webhook-signature).
# Returned on createWebhook when the vendor includes `secret`.
SHOPMONKEY_WEBHOOK_SECRET=your_webhook_shared_secret_here
