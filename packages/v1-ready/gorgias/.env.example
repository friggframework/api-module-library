# Gorgias OAuth2 app credentials from the Gorgias Developer Portal
# https://developers.gorgias.com/docs/oauth2-authentication-for-creating-apps-with-gorgias
GORGIAS_CLIENT_ID=
GORGIAS_CLIENT_SECRET=

# Space-separated OAuth2 scopes. Prefer granular scopes over deprecated write:all.
# See https://developers.gorgias.com/docs/oauth2-scopes
GORGIAS_SCOPE=openid email profile offline account:read tickets:read tickets:write customers:read customers:write integrations:read integrations:write

# Shared Frigg redirect base; module appends /gorgias (and ?account=<subdomain> when known)
REDIRECT_URI=https://localhost:3000/redirect

# Optional: default helpdesk subdomain for local auth tests (acme from acme.gorgias.com)
GORGIAS_SUBDOMAIN=
