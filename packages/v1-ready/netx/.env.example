# NetX OAuth app credentials (issued by NetX for your integration)
NETX_CLIENT_ID=
NETX_CLIENT_SECRET=
# Default "api" unless NetX issued a dedicated scope paired with your client id
NETX_SCOPE=api
# Optional default instance; normally collected at connect time
NETX_BASE_URL=https://your-instance.netx.net
# Shared Frigg OAuth callback root; module appends /netx
REDIRECT_URI=https://localhost/redirect
