# Jobber OAuth 2.0 app credentials from https://developer.getjobber.com/
# Create an app under Manage Apps; Client ID / Client Secret are shown there.
# Scopes are configured on the app in the Developer Center (not passed in the
# authorize URL). OAuth callback URL must match REDIRECT_URI/jobber.
JOBBER_CLIENT_ID=your_jobber_client_id
JOBBER_CLIENT_SECRET=your_jobber_client_secret

# Shared Frigg redirect base; the module appends /jobber.
REDIRECT_URI=https://your-app.example.com/redirect

# Optional: pin GraphQL API version (default 2025-04-16 per Jobber docs).
# JOBBER_GRAPHQL_VERSION=2025-04-16
