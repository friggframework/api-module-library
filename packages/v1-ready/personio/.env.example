# Personio OAuth 2.0 client credentials (Marketplace → Connected integrations → Create custom integration)
PERSONIO_CLIENT_ID=
PERSONIO_CLIENT_SECRET=
# Optional space-delimited scopes; omit to receive all scopes granted to the credential
PERSONIO_SCOPE=
# Company id used as the entity externalId (matches webhook payload company_id for tenant routing)
PERSONIO_COMPANY_ID=
# Comma-separated signing secret(s) for inbound webhook verification (active [, retiring])
PERSONIO_WEBHOOK_SIGNING_SECRET=
