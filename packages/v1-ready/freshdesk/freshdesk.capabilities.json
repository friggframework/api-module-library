{
  "schema": "capability-manifest/v0.1",
  "module": "freshdesk",
  "package": "@friggframework/api-module-freshdesk",
  "version": "1.0.0",
  "auth": {
    "type": "basic",
    "methods": {
      "testAuth": "testAuth"
    },
    "credentials": ["domain", "api_key"],
    "docs": "https://developers.freshdesk.com/api/#authentication"
  },
  "objects": {
    "account": {
      "description": "Freshdesk helpdesk account identity (GET /account)",
      "fields": [
        { "name": "account_id", "tags": ["identifier", "required"] },
        { "name": "account_name", "tags": ["display"] },
        { "name": "account_domain", "tags": ["identity"] },
        { "name": "organisation_id", "tags": ["identifier"] },
        { "name": "organisation_name", "tags": ["display"] },
        { "name": "timezone", "tags": [] },
        { "name": "data_center", "tags": [] },
        { "name": "tier_type", "tags": [] }
      ],
      "capabilities": {
        "get": {
          "method": "getAccount",
          "spec": "freshdesk.openapi.yaml#/paths/~1account/get"
        }
      }
    },
    "agent": {
      "description": "Freshdesk agents (support staff)",
      "fields": [
        { "name": "id", "tags": ["identifier", "required"] },
        { "name": "occasional", "tags": [] },
        { "name": "ticket_scope", "tags": ["enum"] },
        { "name": "type", "tags": ["enum"] },
        { "name": "contact.email", "tags": ["pii", "identity"] },
        { "name": "contact.name", "tags": ["pii", "display"] },
        { "name": "available", "tags": [] },
        { "name": "created_at", "tags": ["timestamp"] },
        { "name": "updated_at", "tags": ["timestamp"] }
      ],
