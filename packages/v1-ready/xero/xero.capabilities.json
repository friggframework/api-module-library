        {
          "name": "LastName",
          "type": "string",
          "tag": "person.familyName"
        },
        {
          "name": "EmailAddress",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "ContactStatus",
          "type": "string",
